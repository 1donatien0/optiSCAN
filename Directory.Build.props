<Project>
  <!-- vM.m = nom de release (README) ; <Version> = semver build / Inno AppVersion -->
  <PropertyGroup>
    <Version>3.1.0</Version>
    <AssemblyVersion>3.1.0.0</AssemblyVersion>
    <FileVersion>3.1.0.0</FileVersion>
    <InformationalVersion>3.1.0</InformationalVersion>
    <!-- Métadonnées exigées sur chaque binaire signé (politique SignPath). Les projets peuvent
         préciser <Product> ; le nom de produit vérifié à la signature est « optiSCAN ». -->
    <Product Condition="'$(Product)' == ''">optiSCAN</Product>
    <Company>Dona By</Company>
    <Copyright>Copyright 2026 Dona By. Licence GPL-3.0-or-later.</Copyright>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- L'interface ne propose que fr-FR et en-US. Garder les satellites .NET
       correspondants dans le paquet autonome, sans les autres langues du runtime. -->
  <PropertyGroup Condition="'$(OptiscanShipping)' == 'true'">
    <SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Analyseurs .NET : ceux du SDK .NET 10 (global.json), sans paquet NuGet séparé
       qui retarderait sur le SDK. -->
</Project>
