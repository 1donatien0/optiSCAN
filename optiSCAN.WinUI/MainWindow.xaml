<Window
    x:Class="optiSCAN.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="optiSCAN">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{ThemeResource SidebarBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image
                Width="48"
                Height="48"
                Margin="0,16,0,12"
                HorizontalAlignment="Center"
                Source="ms-appx:///Assets/optiSCAN_hero.png" />

            <NavigationView
                x:Name="Navigation"
                Grid.Row="1"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                PaneDisplayMode="LeftCompact"
                CompactPaneLength="96"
                OpenPaneLength="96"
                Background="Transparent"
                SelectionChanged="Navigation_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="NavOverview" Content="Accueil" Icon="Home" Tag="overview" IsSelected="True" />
                    <NavigationViewItem x:Name="NavClean" Content="Nettoyer" Icon="Repair" Tag="clean" />
                    <NavigationViewItem x:Name="NavAntivirus" Tag="antivirus">
                        <NavigationViewItem.Content>
                            <StackPanel Spacing="0">
                                <TextBlock x:Name="NavAntivirusLabel" Text="Antivirus" />
                                <TextBlock
                                    x:Name="ClamAvNavBadge"
                                    FontSize="10"
                                    Foreground="{ThemeResource SuccessGreen}"
                                    Text="ClamAV" />
                            </StackPanel>
                        </NavigationViewItem.Content>
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE83D;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavHistory" Tag="history">
                        <NavigationViewItem.Content>
                            <TextBlock x:Name="NavHistoryLabel" Text="Historique" />
                        </NavigationViewItem.Content>
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE81C;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavOptions" Content="Options" Icon="Setting" Tag="options" />
                </NavigationView.MenuItems>
            </NavigationView>

            <StackPanel Grid.Row="2" Spacing="6">
                <Button
                    x:Name="ThemeToggleButton"
                    HorizontalAlignment="Center"
                    Padding="10,8"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="ThemeToggle_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="ThemeToggleIcon" FontSize="16" Glyph="&#xE708;" />
                        <TextBlock x:Name="ThemeToggleLabel" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="OpenOptionsFooterButton"
                    HorizontalAlignment="Center"
                    Padding="10,4"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OpenOptionsFooter_Click">
                    <TextBlock x:Name="FooterLangHint" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
                <TextBlock
                    x:Name="VersionText"
                    Margin="8,0,8,12"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    FontSize="11"
                    TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl
                x:Name="PageHost"
                Grid.Row="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />

            <Border Grid.Row="1" Style="{StaticResource StatusBarStyle}" Padding="32,8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing
                        x:Name="StatusProgressRing"
                        Grid.Column="0"
                        Width="16"
                        Height="16"
                        IsActive="False"
                        Visibility="Collapsed"
                        VerticalAlignment="Center" />
                    <FontIcon
                        x:Name="StatusIcon"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource AccentBrush}"
                        Glyph="&#xE735;"
                        FontSize="14" />
                    <TextBlock
                        x:Name="StatusText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextMutedBrush}"
                        Text="optiSCAN" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
