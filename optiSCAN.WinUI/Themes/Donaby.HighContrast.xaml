<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Contraste renforcé — couleurs unies à fort contraste (WCAG AA).
         Fusionné APRÈS Donaby.Light dans le dictionnaire de thème « Light » par WinUiThemeManager ;
         le thème clair est forcé tant que le contraste renforcé est actif (palette pensée sur fond blanc).
         Jeu de clés IDENTIQUE dans Light / Dark / HighContrast (vérifié par scripts/check-winui-theme-keys.ps1).
         Textes principaux : ressources système WinUI (TextFillColor*). Ici : marque, sémantique,
         surfaces (fond, volet, cartes). Toute couleur utilisée comme TEXTE vise ≥ 4,5:1 (WCAG AA). -->

    <!-- Accent (clé canonique : AccentBrush — surchargée à l'exécution par le preset / la couleur perso) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#000080" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="#FFFF00" />
    <!-- Alias historique utilisé par optiSCAN.Application (ActivityEntry.IconBrushKey) -->
    <SolidColorBrush x:Key="TextAccent" Color="#000080" />

    <!-- Jeu sémantique : Success / Warning / Danger / Info -->
    <SolidColorBrush x:Key="SuccessGreen" Color="#007A52" />
    <SolidColorBrush x:Key="WarningBrush" Color="#7A4A00" />
    <SolidColorBrush x:Key="AlertBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerRed" Color="#8B0000" />
    <SolidColorBrush x:Key="InfoBrush" Color="#000080" />

    <SolidColorBrush x:Key="TextMutedBrush" Color="#333333" />
    <SolidColorBrush x:Key="TextOnPrimary" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardAltBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#000000" />
    <SolidColorBrush x:Key="WarningTintBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#8B0000" />

    <!-- Niveaux de risque (clés fournies par RiskScoringService.GetSeverityBrushKey) -->
    <SolidColorBrush x:Key="RiskCritical" Color="#8B0000" />
    <SolidColorBrush x:Key="RiskMajor" Color="#7A3300" />
    <SolidColorBrush x:Key="RiskMinor" Color="#7A4A00" />
    <SolidColorBrush x:Key="RiskInformational" Color="#007A52" />

    <!-- SystemAccentColor et ses variantes Light1..3 / Dark1..3 sont injectés par WinUiThemeManager
         (le compilateur XAML WinUI ne reconnaît pas <Color> : avertissement WMC0001, bloquant en Release). -->

</ResourceDictionary>
