<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:optiSCAN.WinUI.Converters">

    <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Échelle d'espacement (multiples de 4) — à utiliser à la place de valeurs libres.
         SpacingXXS (2) est réservé aux paires titre / sous-titre très serrées. -->
    <x:Double x:Key="SpacingXXS">2</x:Double>
    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingS">8</x:Double>
    <x:Double x:Key="SpacingM">12</x:Double>
    <x:Double x:Key="SpacingL">16</x:Double>
    <x:Double x:Key="SpacingXL">24</x:Double>

    <!-- Gouttière de page unique (ScrollViewer de page ET grilles racines d'Antivirus / Historique) -->
    <Thickness x:Key="PagePadding">32,20,32,16</Thickness>
    <!-- Décalage du contenu sous une barre d'onglets / un sélecteur -->
    <Thickness x:Key="TabContentPadding">0,8,0,0</Thickness>

    <!-- Styles partagés — rendu natif WinUI 3 (Fluent sobre : surfaces système, pas de dégradé) -->

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="MutedCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Carte unique pour toutes les pages : mêmes surfaces Donaby (opaques, contrastées sur
         AppBackgroundBrush en clair comme en sombre ; bordure noire en contraste renforcé).
         Les anciennes cartes système (CardBackgroundFillColorDefault / CardStrokeColorDefault)
         différaient de l'Accueil et leur bordure disparaissait presque en sombre. -->
    <Style x:Key="AppCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- Cartes de l'Accueil : même carte, remplissage vertical de la rangée -->
    <Style x:Key="OverviewCardStyle" TargetType="Border" BasedOn="{StaticResource AppCardStyle}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!-- Encart dans une carte (statistiques, posture) : rayon plus petit que la carte parente -->
    <Style x:Key="InsetPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardAltBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- Barre d'actions (boutons) en tête d'onglet : carte compacte -->
    <Style x:Key="ToolbarCardStyle" TargetType="Border" BasedOn="{StaticResource AppCardStyle}">
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="AppAccentCardStyle" TargetType="Border" BasedOn="{StaticResource AppCardStyle}">
        <Setter Property="Background" Value="{ThemeResource AccentTintBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Historique : ancien style « hero » à dégradé, désormais identique à la carte d'accent (sobre) -->
    <Style x:Key="AppHeroCardStyle" TargetType="Border" BasedOn="{StaticResource AppAccentCardStyle}" />

    <Style x:Key="PageScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Padding" Value="{StaticResource PagePadding}" />
    </Style>

    <Style x:Key="PageContentPanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="12" />
        <Setter Property="MaxWidth" Value="1000" />
    </Style>

    <!-- État « coché » : volontairement laissé au template WinUI (ToggleButtonBackgroundChecked =
         AccentFillColorDefaultBrush + texte TextOnAccent) — contraste garanti dans tous les thèmes,
         y compris avec l'accent HC navy. Le Background ci-dessous ne s'applique qu'à l'état non coché. -->
    <Style x:Key="FilterChipStyle" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="CornerRadius" Value="14" />
        <!-- Non coché : pastille « carte » (le remplissage Subtle était quasi invisible sur le fond clair) -->
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Vignettes d'action de l'accueil (Nettoyer / Scanner / Historique / Mise à jour) -->
    <Style x:Key="TileButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="TileTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="TileSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedCaptionStyle}">
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <!-- Petit statut sous un libellé de navigation (ex. « ClamAV actif ») -->
    <Style x:Key="NavBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="10" />
    </Style>

    <Style x:Key="StatusBarStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style x:Key="NavPaneHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="LogMonospaceStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Ancien bandeau à dégradé : désormais un simple en-tête sans fond (sobre, plus léger à peindre) -->
    <Style x:Key="PageHeroBannerStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,0,0,4" />
    </Style>

    <Style x:Key="MetricIconBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="LogConsoleBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardAltBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style x:Key="SelectionPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardAltBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Bouton discret du pied de volet (thème, langue). Défini ici pour ne pas dépendre d'un style
         qui n'existe pas dans toutes les versions de WinUI. -->
    <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- Pastille de niveau de risque (listes Antivirus et Historique). Le fond est posé par
         svc:ThemeBrush.BackgroundKey="{x:Bind RiskBrushKey}" (RiskCritical / RiskMajor / RiskMinor /
         RiskInformational) pour suivre les bascules clair / sombre ; TextOnPrimary est défini par thème
         (blanc sur les fonds foncés du thème clair, quasi-noir sur les fonds pastel du thème sombre). -->
    <Style x:Key="RiskPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RiskPillTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextOnPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Bouton-icône des lignes de liste (menaces, quarantaine, historique) -->
    <Style x:Key="RowIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

</ResourceDictionary>
