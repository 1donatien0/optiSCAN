<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Donaby sombre — accent violet.
         Jeu de clés IDENTIQUE dans Light / Dark / HighContrast (vérifié par scripts/check-winui-theme-keys.ps1).
         Textes principaux : ressources système WinUI (TextFillColor*). Ici : marque, sémantique,
         surfaces (fond, volet, cartes). Toute couleur utilisée comme TEXTE vise ≥ 4,5:1 (WCAG AA). -->

    <!-- Accent (clé canonique : AccentBrush — surchargée à l'exécution par le preset / la couleur perso) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#9F97F0" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="#26215C" />
    <!-- Alias historique utilisé par optiSCAN.Application (ActivityEntry.IconBrushKey) -->
    <SolidColorBrush x:Key="TextAccent" Color="#9F97F0" />

    <!-- Jeu sémantique : Success / Warning / Danger / Info -->
    <SolidColorBrush x:Key="SuccessGreen" Color="#6CCB5F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="AlertBg" Color="#412402" />
    <SolidColorBrush x:Key="DangerRed" Color="#FF99A4" />
    <SolidColorBrush x:Key="InfoBrush" Color="#60CDFF" />

    <SolidColorBrush x:Key="TextMutedBrush" Color="#9A9A9A" />
    <!-- Texte sur les pastilles de risque (fonds pastel en sombre) : quasi-noir, ≥ 7:1 -->
    <SolidColorBrush x:Key="TextOnPrimary" Color="#1B1B1B" />

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#141414" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="CardAltBackgroundBrush" Color="#252525" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="WarningTintBrush" Color="#412402" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />

    <!-- Niveaux de risque (clés fournies par RiskScoringService.GetSeverityBrushKey) -->
    <SolidColorBrush x:Key="RiskCritical" Color="#FF99A4" />
    <SolidColorBrush x:Key="RiskMajor" Color="#FF9F5A" />
    <SolidColorBrush x:Key="RiskMinor" Color="#FCE100" />
    <SolidColorBrush x:Key="RiskInformational" Color="#6CCB5F" />

    <!-- SystemAccentColor et ses variantes Light1..3 / Dark1..3 sont injectés par WinUiThemeManager
         (le compilateur XAML WinUI ne reconnaît pas <Color> : avertissement WMC0001, bloquant en Release). -->

</ResourceDictionary>
