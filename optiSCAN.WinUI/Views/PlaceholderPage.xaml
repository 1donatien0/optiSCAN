<Page
    x:Class="optiSCAN.WinUI.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="{StaticResource PagePadding}">
        <StackPanel Spacing="{StaticResource SpacingS}" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="BodyText" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>
    </Grid>
</Page>
