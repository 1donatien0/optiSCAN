<UserControl
    x:Class="optiSCAN.WinUI.Views.TweaksPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="{StaticResource SpacingM}" Padding="{StaticResource TabContentPadding}">
        <!-- Actions -->
        <Border Style="{StaticResource ToolbarCardStyle}">
            <StackPanel Spacing="{StaticResource SpacingS}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                    <ProgressRing Width="22" Height="22" VerticalAlignment="Center"
                                  IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <Button x:Name="ApplyButton" Click="Apply_Click" MinWidth="140"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                            <TextBlock x:Name="ApplyLabel" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StartupButton" Click="Startup_Click">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                            <FontIcon Glyph="&#xE7E8;" FontSize="14" />
                            <TextBlock x:Name="StartupLabel" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="ElevNoteText" Style="{StaticResource MutedCaptionStyle}" TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>

        <Grid ColumnSpacing="{StaticResource SpacingM}" MinHeight="240">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tweaks -->
            <Border Grid.Column="0" Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="{StaticResource SpacingM}">
                    <TextBlock x:Name="SectionPerfText" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel Spacing="{StaticResource SpacingXS}">
                        <CheckBox x:Name="ChkPowerPlan" IsChecked="{x:Bind ViewModel.PowerPlan, Mode=TwoWay}" />
                        <CheckBox x:Name="ChkVisualFx" IsChecked="{x:Bind ViewModel.VisualFx, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock x:Name="SectionPrivacyText" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel Spacing="{StaticResource SpacingXS}">
                        <CheckBox x:Name="ChkTelemetry" IsChecked="{x:Bind ViewModel.Telemetry, Mode=TwoWay}" />
                        <CheckBox x:Name="ChkAds" IsChecked="{x:Bind ViewModel.Ads, Mode=TwoWay}" />
                        <CheckBox x:Name="ChkSuggestions" IsChecked="{x:Bind ViewModel.Suggestions, Mode=TwoWay}" />
                        <CheckBox x:Name="ChkTailored" IsChecked="{x:Bind ViewModel.Tailored, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock x:Name="SectionUiText" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel Spacing="{StaticResource SpacingXS}">
                        <CheckBox x:Name="ChkShowExt" IsChecked="{x:Bind ViewModel.ShowExt, Mode=TwoWay}" />
                        <CheckBox x:Name="ChkShowHidden" IsChecked="{x:Bind ViewModel.ShowHidden, Mode=TwoWay}" />
                        <CheckBox x:Name="ChkTaskbarLeft" IsChecked="{x:Bind ViewModel.TaskbarLeft, Mode=TwoWay}" />
                        <CheckBox x:Name="ChkHideWidgets" IsChecked="{x:Bind ViewModel.HideWidgets, Mode=TwoWay}" />
                        <CheckBox x:Name="ChkSearchIcon" IsChecked="{x:Bind ViewModel.SearchIcon, Mode=TwoWay}" />
                        <CheckBox x:Name="ChkThisPc" IsChecked="{x:Bind ViewModel.ThisPc, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock x:Name="SectionMaintText" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel Spacing="{StaticResource SpacingXS}">
                        <CheckBox x:Name="ChkDism" IsChecked="{x:Bind ViewModel.Dism, Mode=TwoWay}" />
                        <CheckBox x:Name="ChkDefenderHistory" IsChecked="{x:Bind ViewModel.DefenderHistory, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Journal -->
            <Border Grid.Column="1" Style="{StaticResource AppCardStyle}">
                <Grid RowSpacing="{StaticResource SpacingS}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="220" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LogTitle" Grid.Row="0" Style="{StaticResource SectionTitleStyle}" />
                    <Border Grid.Row="1" Style="{StaticResource LogConsoleBorderStyle}">
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{x:Bind ViewModel.LogText, Mode=OneWay}" Style="{StaticResource LogMonospaceStyle}" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
