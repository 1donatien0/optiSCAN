<UserControl
    x:Class="optiSCAN.WinUI.Views.UpdatesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:optiSCAN.WinUI.ViewModels">

    <StackPanel Spacing="{StaticResource SpacingM}" Padding="{StaticResource TabContentPadding}">
        <TextBlock x:Name="HintText" Style="{StaticResource MutedCaptionStyle}" TextWrapping="WrapWholeWords" />

        <!-- Actions -->
        <Border Style="{StaticResource ToolbarCardStyle}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                <ProgressRing Width="22" Height="22" VerticalAlignment="Center"
                              IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <Button x:Name="ScanButton" Click="Scan_Click" MinWidth="120"
                        IsEnabled="{x:Bind ViewModel.CanScan, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                        <TextBlock x:Name="ScanLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="UpdateSelectedButton" Click="UpdateSelected_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.CanUpdateSelected, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                        <FontIcon Glyph="&#xE896;" FontSize="14" />
                        <TextBlock x:Name="UpdateSelectedLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="UpdateAllButton" Click="UpdateAll_Click"
                        IsEnabled="{x:Bind ViewModel.CanUpdateAll, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                        <TextBlock x:Name="UpdateAllLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="WindowsUpdateButton" Click="WindowsUpdate_Click">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                        <FontIcon Glyph="&#xE7B8;" FontSize="14" />
                        <TextBlock x:Name="WindowsUpdateLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid ColumnSpacing="{StaticResource SpacingM}" MinHeight="240">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Liste des mises à jour -->
            <Border Grid.Column="0" Style="{StaticResource AppCardStyle}">
                <Grid RowSpacing="{StaticResource SpacingS}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="220" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ListTitle" Grid.Row="0" Style="{StaticResource SectionTitleStyle}" />
                    <Grid Grid.Row="1">
                        <ListView ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:UpdateRowViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}" Margin="0,4">
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                  MinWidth="0" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Tag, Mode=OneWay}" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource WarningBrush}"
                                                   Visibility="{x:Bind IsWarning, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind Tag, Mode=OneWay}" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource DangerRed}"
                                                   Visibility="{x:Bind IsDanger, Mode=OneWay}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{StaticResource SpacingS}"
                                    Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}">
                            <FontIcon Glyph="&#xE73E;" FontSize="32" Foreground="{ThemeResource SuccessGreen}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyTitle" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptySubtitle" Style="{StaticResource PageSubtitleStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Journal -->
            <Border Grid.Column="1" Style="{StaticResource AppCardStyle}">
                <Grid RowSpacing="{StaticResource SpacingS}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="220" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LogTitle" Grid.Row="0" Style="{StaticResource SectionTitleStyle}" />
                    <Border Grid.Row="1" Style="{StaticResource LogConsoleBorderStyle}">
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{x:Bind ViewModel.LogText, Mode=OneWay}" Style="{StaticResource LogMonospaceStyle}" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
