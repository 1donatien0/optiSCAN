<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>optiSCAN.Tests</RootNamespace>
    <AssemblyName>optiSCAN.Tests</AssemblyName>
    <UseWPF>true</UseWPF>
    <!-- xUnit v3 : xUnit1051 recommande TestContext.Current.CancellationToken dans chaque appel.
         Les tests ont leurs propres délais ; la règle n'apporte qu'une annulation plus rapide. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\optiSCAN\optiSCAN.csproj" />
    <ProjectReference Include="..\optiSCAN.Platform\optiSCAN.Platform.csproj" />
    <ProjectReference Include="..\optiSCAN.Engine\optiSCAN.Engine.csproj" />
    <ProjectReference Include="..\optiSCAN.Host\optiSCAN.Host.csproj" />
  </ItemGroup>

</Project>
