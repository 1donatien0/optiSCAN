<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>optiSCAN.Service</RootNamespace>
    <AssemblyName>optiSCAN.Service</AssemblyName>
    <Product>optiSCAN v1.0 Protection Service</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\optiSCAN.IPC\optiSCAN.IPC.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\native\optiSCAN.Minifilter\optiSCAN.Minifilter.inf" Condition="Exists('..\native\optiSCAN.Minifilter\optiSCAN.Minifilter.inf')">
      <Link>optiSCAN.Minifilter.inf</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
