<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Windows.Forms requis pour FolderBrowserDialog -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Assure que l'application demande les droits admin (nécessaire pour scanner C:\Windows) -->
    <!-- Voir app.manifest : requestedExecutionLevel level="requireAdministrator" -->
    <AssemblyName>optiSCAN</AssemblyName>
    <RootNamespace>optiSCAN</RootNamespace>
    <Version>3.0.0</Version>
    <Company>optiSCAN</Company>
    <Product>optiSCAN — ClamAV Edition</Product>
    <Copyright>Copyright 2026 Dona By</Copyright>
    <!-- Icône embarquée dans le .exe (taskbar, explorateur, setup) -->
    <ApplicationIcon>optiSCAN.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="ico.ico" />
    <None Remove="optiSCAN.png" />
    <None Remove="icons8-historique-des-commandes-50.png" />
    <None Remove="icons8-mises-à-jour-disponibles-50.png" />
    <None Remove="icons8-nettoyer-50.png" />
    <None Remove="icons8-www-50.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="ico.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="optiSCAN.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="optiSCAN.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="icons8-historique-des-commandes-50.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="icons8-mises-à-jour-disponibles-50.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="icons8-nettoyer-50.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="icons8-www-50.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <!-- Binaires YARA -->
    <Content Include="yara\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Règles YARA (.yar) -->
    <Content Include="rules\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Base de signatures ClamAV partagée -->
    <Content Include="clamav\database\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- CA Cisco-Talos pour la vérification des signatures CVD (ClamAV ≥ 1.5) — copié à côté de freshclam ou en LocalAppData -->
    <Content Include="clamav\certs\clamav.crt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Exclusion des fichiers .conf de la copie :
    FreshclamUpdater et ClamDaemon génèrent leur propre conf à l'exécution
    dans %LocalAppData%\optiSCAN\clamav\. Un freshclam.conf copié depuis le
    repo contiendrait des chemins de la machine de dev (DatabaseDirectory =
    D:\Projets\...) qui seraient invalides sur l'installation utilisateur,
    et provoquerait des erreurs freshclam à l'init.
  -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(PlatformTarget)' == 'x64'">
    <Content Include="clamav\x64\**\*" Exclude="clamav\x64\**\*.conf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x86' Or '$(PlatformTarget)' == 'x86'">
    <Content Include="clamav\x86\**\*" Exclude="clamav\x86\**\*.conf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Fallback IDE: si aucune architecture n'est précisée, on copie les deux. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' And '$(PlatformTarget)' == ''">
    <Content Include="clamav\x64\**\*" Exclude="clamav\x64\**\*.conf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="clamav\x86\**\*" Exclude="clamav\x86\**\*.conf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.1" />
    <!-- Phase 2 : services avancés -->
    <PackageReference Include="QuestPDF" Version="2024.12.2" />

    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.0.5" NoWarn="NU1701" />
  </ItemGroup>


  <ItemGroup>
    <Compile Update="Views\OptionsControl.xaml.cs">
      <Generator>MSBuild:Compile</Generator>
    </Compile>
    <Compile Update="Views\HistoryControl.xaml.cs">
      <Generator>MSBuild:Compile</Generator>
    </Compile>
    <Compile Update="Views\CleanControl.xaml.cs">
      <Generator>MSBuild:Compile</Generator>
    </Compile>
  </ItemGroup>

</Project>
