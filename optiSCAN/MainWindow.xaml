<Window x:Class="optiSCAN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:optiSCAN.Views"
        xmlns:strings="clr-namespace:optiSCAN.Strings"
        xmlns:loc="clr-namespace:optiSCAN.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc Key=App_Title}"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBg}"
        FontFamily="{DynamicResource AppFontFamily}"
        Icon="optiSCAN.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════
             SIDEBAR SLIM (90 px)
        ═══════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Logo (icône seule) -->
                <StackPanel DockPanel.Dock="Top" Margin="0,18,0,10"
                            HorizontalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12"
                            Background="{DynamicResource AccentBg}"
                            HorizontalAlignment="Center">
                        <md:PackIcon Kind="Shield" Width="24" Height="24"
                                     Foreground="{DynamicResource PrimaryBlue}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <Separator DockPanel.Dock="Top" Background="{DynamicResource BorderSubtle}" Margin="10,0,10,4"/>

                <!-- Boutons bas -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10"
                            HorizontalAlignment="Center">

                    <!-- Version -->
                    <TextBlock x:Name="txtSidebarVersion"
                               Text="…"
                               FontSize="{DynamicResource FontSize.Micro}" Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"
                               TextWrapping="Wrap" TextAlignment="Center" Width="80"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,4"
                            HorizontalAlignment="Center">

                    <!-- Site web (icône seule) -->
                    <Button x:Name="btnWebsite"
                            Click="BtnWebsite_Click"
                            Width="48" Height="36" Margin="0,3"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            Cursor="Hand"
                            ToolTip="Site web">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="8"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <md:PackIcon Kind="Web" Width="16" Height="16"
                                                 Foreground="{DynamicResource TextMedium}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource SidebarHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Mode sombre (icône seule) -->
                    <Button x:Name="btnModesSombre"
                            Click="BtnModesSombre_Click"
                            Width="48" Height="36" Margin="0,3"
                            Background="{DynamicResource ThemeToggleBg}"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Mode sombre">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="8"
                                        Background="{TemplateBinding Background}">
                                    <md:PackIcon Kind="WeatherSunny" Width="16" Height="16"
                                                 Foreground="{DynamicResource ThemeToggleFg}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Séparateur avant boutons bas -->
                <Separator DockPanel.Dock="Bottom"
                           Background="{DynamicResource BorderSubtle}"
                           Margin="10,4,10,4"/>

                <!-- Navigation RadioButtons — icône + label empilés, centrés -->
                <StackPanel DockPanel.Dock="Top">

                    <!-- Vue d'ensemble -->
                    <RadioButton x:Name="navOverview"
                                 Style="{StaticResource NavItem}"
                                 Tag="{x:Static strings:OptiscanStrings+PanelIds.Overview}"
                                 Checked="NavItem_Checked">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <md:PackIcon Kind="Monitor" Width="22" Height="22"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Key=Nav_Home}" FontSize="{DynamicResource FontSize.Micro}" TextAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Nettoyer -->
                    <RadioButton x:Name="navClean"
                                 Style="{StaticResource NavItem}"
                                 Tag="{x:Static strings:OptiscanStrings+PanelIds.Clean}"
                                 Checked="NavItem_Checked">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <md:PackIcon Kind="Broom" Width="22" Height="22"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Key=Nav_Clean}" FontSize="{DynamicResource FontSize.Micro}" TextAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Antivirus -->
                    <RadioButton x:Name="navAntivirus"
                                 Style="{StaticResource NavItem}"
                                 Tag="{x:Static strings:OptiscanStrings+PanelIds.Antivirus}"
                                 Checked="NavItem_Checked">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid HorizontalAlignment="Center">
                                <md:PackIcon Kind="ShieldCheck" Width="22" Height="22"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                                <!-- Badge ClamAV (petit point vert) -->
                                <md:PackIcon x:Name="icoSidebarClamAv"
                                             Kind="ShieldCheck" Width="10" Height="10"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Foreground="{DynamicResource SuccessGreen}"/>
                            </Grid>
                            <TextBlock Text="{loc:Loc Key=Nav_Antivirus}" FontSize="{DynamicResource FontSize.Micro}" TextAlignment="Center"
                                       Margin="0,4,0,0"/>
                            <TextBlock x:Name="txtSidebarClamAvBadge"
                                       Text="{loc:Loc Key=Main_SidebarActive}"
                                       FontSize="{DynamicResource FontSize.Micro}" TextAlignment="Center"
                                       Foreground="{DynamicResource SuccessGreen}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Historique -->
                    <RadioButton x:Name="navHistory"
                                 Style="{StaticResource NavItem}"
                                 Tag="{x:Static strings:OptiscanStrings+PanelIds.History}"
                                 Checked="NavItem_Checked">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <md:PackIcon Kind="History" Width="22" Height="22"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Key=Nav_History}" FontSize="{DynamicResource FontSize.Micro}" TextAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Options -->
                    <RadioButton x:Name="navOptions"
                                 Style="{StaticResource NavItem}"
                                 Tag="{x:Static strings:OptiscanStrings+PanelIds.Options}"
                                 Checked="NavItem_Checked">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <md:PackIcon Kind="Cog" Width="22" Height="22"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Key=Nav_Options}" FontSize="{DynamicResource FontSize.Micro}" TextAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════
             CONTENU PRINCIPAL
        ═══════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="{DynamicResource ContentBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Panneaux (empilés, un seul visible à la fois) -->
            <Grid Grid.Row="0">
                <views:OverviewControl  x:Name="panelOverview"  Visibility="Visible"/>
                <views:AntivirusView    x:Name="panelAntivirus" Visibility="Collapsed"/>
                <views:CleanControl     x:Name="panelClean"     Visibility="Collapsed"/>
                <views:HistoryControl   x:Name="panelHistory"   Visibility="Collapsed"/>
                <views:OptionsControl   x:Name="panelOptions"   Visibility="Collapsed"/>
            </Grid>

            <!-- ── Barre de statut (footer 3 colonnes) ── -->
            <Border Grid.Row="1"
                    Background="{DynamicResource HeaderBg}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,1,0,0"
                    Padding="16,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Gauche : statut + icône -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon x:Name="statusFooterIcon" Kind="CheckboxMarked" Width="14" Height="14"
                                     Foreground="{DynamicResource SuccessGreen}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="lblStatus"
                                   Text="{loc:Loc Key=Main_StatusReady}"
                                   Foreground="{DynamicResource TextMedium}"
                                   FontSize="{DynamicResource FontSize.Body}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Centre : mention légale -->
                    <TextBlock Grid.Column="1"
                               Text="{loc:Loc Key=Main_FooterFree}"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="{DynamicResource FontSize.Small}" VerticalAlignment="Center"
                               Margin="0,0,24,0"
                               FontStyle="Italic"/>

                    <!-- Droite : version + crédit -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="Wrench" Width="12" Height="12"
                                     Foreground="{DynamicResource TextMuted}"
                                     VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock x:Name="txtFooterVersion"
                                   FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource TextMuted}"
                                   Text="{loc:Loc Key=Main_FooterVersion}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
