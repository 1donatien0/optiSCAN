<Window x:Class="optiSCAN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:optiSCAN.Views"
        mc:Ignorable="d"
        Title="optiSCAN — Optimiseur &amp; Antivirus"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBg}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════
             SIDEBAR
        ═══════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="11"
                                Background="{DynamicResource AccentBg}">
                            <md:PackIcon Kind="Shield" Width="24" Height="24"
                                         Foreground="{DynamicResource PrimaryBlue}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="optiSCAN"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextDark}"/>
                            <TextBlock Text="Fourni par Dona By"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Separator DockPanel.Dock="Top" Background="{DynamicResource BorderSubtle}" Margin="0,0,0,4"/>

                <!-- Étiquette MENU -->
                <TextBlock DockPanel.Dock="Top"
                           Text="MENU"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}"
                           Margin="24,10,0,4"
                           />

                <!-- Boutons bas (Dock=Bottom en premier pour être en bas) -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,14">
                    <TextBlock x:Name="txtSidebarVersion"
                               Text="…"
                               FontSize="10" Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,4">
                    <!-- Site web -->
                    <Button x:Name="btnWebsite"
                            Click="BtnWebsite_Click"
                            Height="36" Margin="0,3"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="8"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <md:PackIcon Kind="Web" Width="16" Height="16"
                                                     Foreground="{DynamicResource TextMedium}"
                                                     VerticalAlignment="Center"/>
                                        <TextBlock Text=" Site web"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextMedium}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource SidebarHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Mode sombre -->
                    <Button x:Name="btnModesSombre"
                            Click="BtnModesSombre_Click"
                            Height="36" Margin="0,3"
                            Background="{DynamicResource ThemeToggleBg}"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="8"
                                        Background="{TemplateBinding Background}">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <md:PackIcon Kind="WeatherSunny" Width="16" Height="16"
                                                     Foreground="{DynamicResource ThemeToggleFg}"
                                                     VerticalAlignment="Center"/>
                                        <TextBlock Text=" Mode sombre"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ThemeToggleFg}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Séparateur avant boutons bas -->
                <Separator DockPanel.Dock="Bottom"
                           Background="{DynamicResource BorderSubtle}"
                           Margin="0,6,0,6"/>

                <!-- Statut ClamAV -->
                <Border DockPanel.Dock="Bottom"
                        Background="{DynamicResource SurfaceBg}"
                        CornerRadius="8" Margin="10,0,10,4" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="ClamAV" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock x:Name="txtSidebarAntivirusStatus"
                                   Text="Vérification..."
                                   FontSize="12" FontWeight="SemiBold"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource SuccessGreen}"/>
                    </StackPanel>
                </Border>

                <!-- Navigation RadioButtons -->
                <StackPanel DockPanel.Dock="Top">

                    <!-- Vue d'ensemble — IsChecked défini en code après RegisterPanels()
                         (sinon Checked se déclenche pendant InitializeComponent avant l'enregistrement des panneaux). -->
                    <RadioButton x:Name="navOverview"
                                 Style="{StaticResource NavItem}"
                                 Tag="Overview"
                                 Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Monitor" Width="18" Height="18"
                                         VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Vue d'ensemble" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Nettoyer -->
                    <RadioButton Style="{StaticResource NavItem}"
                                 Tag="Clean"
                                 Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Broom" Width="18" Height="18"
                                         VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Nettoyer" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Antivirus -->
                    <RadioButton Style="{StaticResource NavItem}"
                                 Tag="Antivirus"
                                 Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ShieldCheck" Width="18" Height="18"
                                         VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Antivirus" FontSize="13"/>
                                <TextBlock x:Name="txtSidebarClamAvBadge"
                                           Text="ClamAV ✅"
                                           FontSize="10"
                                           Foreground="{DynamicResource SuccessGreen}"/>
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>

                    <!-- Historique -->
                    <RadioButton Style="{StaticResource NavItem}"
                                 Tag="History"
                                 Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="History" Width="18" Height="18"
                                         VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Historique" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Options -->
                    <RadioButton Style="{StaticResource NavItem}"
                                 Tag="Options"
                                 Checked="NavItem_Checked">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Cog" Width="18" Height="18"
                                         VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Options" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════
             CONTENU PRINCIPAL
        ═══════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="{DynamicResource ContentBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Panneaux (empilés, un seul visible à la fois) -->
            <Grid Grid.Row="0">
                <views:OverviewControl  x:Name="panelOverview"  Visibility="Visible"/>
                <views:AntivirusView    x:Name="panelAntivirus" Visibility="Collapsed"/>
                <views:CleanControl     x:Name="panelClean"     Visibility="Collapsed"/>
                <views:HistoryControl   x:Name="panelHistory"   Visibility="Collapsed"/>
                <views:OptionsControl   x:Name="panelOptions"   Visibility="Collapsed"/>
            </Grid>

            <!-- ── Barre de statut (footer 3 colonnes) ── -->
            <Border Grid.Row="1"
                    Background="{DynamicResource HeaderBg}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,1,0,0"
                    Padding="16,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Gauche : statut + icône -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="CheckboxMarked" Width="14" Height="14"
                                     Foreground="{DynamicResource SuccessGreen}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="lblStatus"
                                   Text="Prêt — protection active."
                                   Foreground="{DynamicResource TextMedium}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Centre : mention légale -->
                    <TextBlock Grid.Column="1"
                               Text="optiSCAN est un logiciel gratuit — Vanier, Canada."
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="11" VerticalAlignment="Center"
                               Margin="0,0,24,0"
                               FontStyle="Italic"/>

                    <!-- Droite : version + crédit -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="Wrench" Width="12" Height="12"
                                     Foreground="{DynamicResource TextMuted}"
                                     VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock x:Name="txtFooterVersion"
                                   FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   Text="optiSCAN — Fourni par Dona By"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
