<UserControl x:Class="optiSCAN.Views.CleanControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer Background="{DynamicResource ContentBg}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">

            <TextBlock Text="Nettoyage du système"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextDark}"
                       Margin="0,0,0,16"/>

            <!-- ── 3 Cartes de taille ─────────────────────────────────────── -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Temp Windows -->
                <Border Grid.Column="0" CornerRadius="12"
                        Background="{DynamicResource CardBg}"
                        Effect="{DynamicResource CardShadow}" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="38" Height="38" CornerRadius="8"
                                    Background="{DynamicResource AlertBg}">
                                <md:PackIcon Kind="Folder" Width="22" Height="22"
                                             Foreground="{DynamicResource AlertGoldLight}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Temp Windows"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextDark}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="txtTempSize" Text="0 Mo"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource AlertGoldLight}"/>
                        <TextBlock Text="Windows Temp + Temp utilisateur"
                                   FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Navigateurs -->
                <Border Grid.Column="2" CornerRadius="12"
                        Background="{DynamicResource CardBg}"
                        Effect="{DynamicResource CardShadow}" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="38" Height="38" CornerRadius="8"
                                    Background="{DynamicResource AlertBg}">
                                <md:PackIcon Kind="Web" Width="22" Height="22"
                                             Foreground="{DynamicResource AlertGoldLight}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Navigateurs"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextDark}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="txtBrowserSize" Text="0 Mo"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource AlertGoldLight}"/>
                        <TextBlock Text="Edge + Chrome + Firefox"
                                   FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Total libérable (accent violet) -->
                <Border Grid.Column="4" CornerRadius="12"
                        Background="{DynamicResource PrimaryBlue}"
                        Effect="{DynamicResource CardShadow}" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="38" Height="38" CornerRadius="8"
                                    Background="#33FFFFFF">
                                <md:PackIcon Kind="ChartBar" Width="22" Height="22"
                                             Foreground="White"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Total libérable"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="txtTotalSize" Text="0 Mo"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Somme des cibles cochées"
                                   FontSize="11" Foreground="#CCFFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Barre Analyser / Nettoyer ─────────────────────────────── -->
            <Border Background="{DynamicResource CardBg}"
                    CornerRadius="12" Padding="20,14"
                    Effect="{DynamicResource CardShadow}"
                    Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnAnalyze"
                            Click="btnAnalyze_Click"
                            Style="{StaticResource SecondaryButton}"
                            Height="40" Width="150" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Magnify" Width="16" Height="16"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="  Analyser" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnCleanNow"
                            Click="btnCleanNow_Click"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="False"
                            Height="40" Width="200">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Broom" Width="16" Height="16"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="  Nettoyer maintenant" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="txtAnalyzeHint"
                               Text="  ← Lancez d'abord une analyse"
                               FontSize="11" Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- ── Corps : Éléments à nettoyer + Journal ────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Éléments à nettoyer -->
                <Border Grid.Column="0" CornerRadius="12"
                        Background="{DynamicResource CardBg}"
                        Effect="{DynamicResource CardShadow}" Padding="0,16,0,16">
                    <StackPanel>
                        <TextBlock Text="Éléments à nettoyer"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDark}"
                                   Margin="20,0,20,12"/>

                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20,0">

                                <!-- SYSTÈME -->
                                <TextBlock Text="SYSTÈME"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBlue}"
                                           Margin="0,0,0,8"/>
                                <Border Background="{DynamicResource SurfaceBg}"
                                        CornerRadius="8" Padding="12,4" Margin="0,0,0,12">
                                    <StackPanel>
                                        <CheckBox x:Name="chkTempWin"
                                                  Content="Temp Windows" IsChecked="True"
                                                  Margin="0,6"/>
                                        <CheckBox x:Name="chkTempUser"
                                                  Content="Temp utilisateur" IsChecked="True"
                                                  Margin="0,6"/>
                                        <CheckBox x:Name="chkRecycleBin"
                                                  Content="Corbeille" IsChecked="True"
                                                  Margin="0,6"/>
                                        <CheckBox x:Name="chkLogs"
                                                  Content="Anciens journaux système" IsChecked="False"
                                                  Margin="0,6"/>
                                    </StackPanel>
                                </Border>

                                <!-- NAVIGATEURS -->
                                <TextBlock Text="NAVIGATEURS"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBlue}"
                                           Margin="0,0,0,8"/>
                                <Border Background="{DynamicResource SurfaceBg}"
                                        CornerRadius="8" Padding="12,4">
                                    <StackPanel>
                                        <CheckBox x:Name="chkEdge"
                                                  Content="Microsoft Edge" IsChecked="True"
                                                  Margin="0,6"/>
                                        <CheckBox x:Name="chkChrome"
                                                  Content="Google Chrome" IsChecked="True"
                                                  Margin="0,6"/>
                                        <CheckBox x:Name="chkFirefox"
                                                  Content="Mozilla Firefox" IsChecked="True"
                                                  Margin="0,6"/>
                                        <CheckBox x:Name="chkBrave"
                                                  Content="Brave" IsChecked="False"
                                                  Margin="0,6"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Journal d'opérations -->
                <Border Grid.Column="2" CornerRadius="12"
                        Background="{DynamicResource CardBg}"
                        Effect="{DynamicResource CardShadow}" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="Journal d'opérations"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDark}"
                                   Margin="0,0,0,10"/>
                        <ScrollViewer Height="300" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="txtCleanLog"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextMedium}"
                                     FontFamily="Consolas" FontSize="11"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Text="Cliquez sur Analyser pour estimer l’espace récupérable&#x0a;(fichiers temporaires et caches des navigateurs cochés)."/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>