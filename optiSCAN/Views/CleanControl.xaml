<UserControl x:Class="optiSCAN.Views.CleanControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

    <DockPanel Background="{DynamicResource ContentBg}">

        <Border DockPanel.Dock="Top"
                Margin="16,16,16,0"
                CornerRadius="12"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                Background="{DynamicResource PageHeaderMica}"
                Effect="{DynamicResource CardShadow}"
                Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Nettoyage du système"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDark}"/>
                    <TextBlock Text="Libérez de l'espace en supprimant les fichiers inutiles."
                               FontSize="11" Foreground="{DynamicResource TextMuted}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="48" Height="48" CornerRadius="24"
                        Background="{DynamicResource PageHeaderIconRing}"
                        BorderBrush="{DynamicResource PageHeaderIconBorder}"
                        BorderThickness="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                    <md:PackIcon Kind="Broom" Width="26" Height="26"
                                 Foreground="{DynamicResource TextAccent}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <Grid Margin="16,12,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="10"
                        Background="{DynamicResource CardBg}"
                        Effect="{DynamicResource CardShadow}" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="32" Height="32" CornerRadius="8"
                                    Background="{DynamicResource AlertBg}">
                                <md:PackIcon Kind="Folder" Width="18" Height="18"
                                             Foreground="{DynamicResource AlertGoldLight}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Temp Windows"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextDark}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="txtTempSize" Text="0 Mo"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource AlertGoldLight}"/>
                        <TextBlock Text="Windows Temp + utilisateur"
                                   FontSize="10" Foreground="{DynamicResource TextMuted}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="10"
                        Background="{DynamicResource CardBg}"
                        Effect="{DynamicResource CardShadow}" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="32" Height="32" CornerRadius="8"
                                    Background="{DynamicResource AlertBg}">
                                <md:PackIcon Kind="Web" Width="18" Height="18"
                                             Foreground="{DynamicResource AlertGoldLight}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Navigateurs"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextDark}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="txtBrowserSize" Text="0 Mo"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource AlertGoldLight}"/>
                        <TextBlock Text="Caches navigateurs cochés"
                                   FontSize="10" Foreground="{DynamicResource TextMuted}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" CornerRadius="10"
                        Background="{DynamicResource PrimaryBlue}"
                        Effect="{DynamicResource CardShadow}" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="32" Height="32" CornerRadius="8"
                                    Background="#33FFFFFF">
                                <md:PackIcon Kind="ChartBar" Width="18" Height="18"
                                             Foreground="{DynamicResource TextOnPrimary}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Total libérable"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextOnPrimary}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="txtTotalSize" Text="0 Mo"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextOnPrimary}"/>
                        <TextBlock Text="Cibles cochées"
                                   FontSize="10" Foreground="{DynamicResource TextOnPrimaryMuted}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource CardBg}"
                    CornerRadius="10" Padding="14,10"
                    Effect="{DynamicResource CardShadow}"
                    Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnAnalyze"
                            Click="btnAnalyze_Click"
                            Style="{StaticResource SecondaryButton}"
                            Height="36" Width="140" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Magnify" Width="15" Height="15"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="  Analyser" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnCleanNow"
                            Click="btnCleanNow_Click"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="False"
                            Height="36" Width="190">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Broom" Width="15" Height="15"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="  Nettoyer maintenant" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="10"
                        Background="{DynamicResource CardBg}"
                        Effect="{DynamicResource CardShadow}"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Éléments à nettoyer"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDark}"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="SYSTÈME"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBlue}"
                                   Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource SurfaceBg}"
                                CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                            <UniformGrid Columns="2">
                                <CheckBox x:Name="chkTempWin"
                                          Content="Temp Windows" IsChecked="True"
                                          Margin="2,2" FontSize="11"/>
                                <CheckBox x:Name="chkTempUser"
                                          Content="Temp utilisateur" IsChecked="True"
                                          Margin="2,2" FontSize="11"/>
                                <CheckBox x:Name="chkRecycleBin"
                                          Content="Corbeille" IsChecked="True"
                                          Margin="2,2" FontSize="11"/>
                                <CheckBox x:Name="chkLogs"
                                          Content="Journaux système" IsChecked="False"
                                          Margin="2,2" FontSize="11"/>
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="NAVIGATEURS"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBlue}"
                                   Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource SurfaceBg}"
                                CornerRadius="8" Padding="10,6">
                            <UniformGrid Columns="2">
                                <CheckBox x:Name="chkEdge"
                                          Content="Microsoft Edge" IsChecked="True"
                                          Margin="2,2" FontSize="11"/>
                                <CheckBox x:Name="chkChrome"
                                          Content="Google Chrome" IsChecked="True"
                                          Margin="2,2" FontSize="11"/>
                                <CheckBox x:Name="chkFirefox"
                                          Content="Mozilla Firefox" IsChecked="True"
                                          Margin="2,2" FontSize="11"/>
                                <CheckBox x:Name="chkBrave"
                                          Content="Brave" IsChecked="False"
                                          Margin="2,2" FontSize="11"/>
                                <CheckBox x:Name="chkOpera"
                                          Content="Opera" IsChecked="False"
                                          Margin="2,2" FontSize="11"/>
                                <CheckBox x:Name="chkVivaldi"
                                          Content="Vivaldi" IsChecked="False"
                                          Margin="2,2" FontSize="11"/>
                                <CheckBox x:Name="chkArc"
                                          Content="Arc" IsChecked="False"
                                          Margin="2,2" FontSize="11"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="10"
                        Background="{DynamicResource CardBg}"
                        Effect="{DynamicResource CardShadow}"
                        Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="Journal d'opérations"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDark}"
                                   Margin="0,0,0,6"/>
                        <TextBox Grid.Row="1"
                                 x:Name="txtCleanLog"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextMedium}"
                                         FontFamily="{DynamicResource AppFontFamily}" FontSize="10"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Hidden"
                                 HorizontalScrollBarVisibility="Disabled"
                                 VerticalAlignment="Stretch"
                                 Text="Cliquez sur Analyser pour estimer l'espace récupérable&#x0a;(fichiers temporaires et caches des navigateurs cochés)."/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

    </DockPanel>
</UserControl>
