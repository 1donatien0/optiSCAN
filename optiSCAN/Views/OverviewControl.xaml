<UserControl x:Class="optiSCAN.Views.OverviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:strings="clr-namespace:optiSCAN.Strings">

    <!-- Grid racine (pas de ScrollViewer qui laisse du vide gris sous les cartes). -->
    <Grid Background="{DynamicResource ContentBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="24,16,24,0"
                    CornerRadius="12"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    Background="{DynamicResource PageHeaderMica}"
                    Effect="{DynamicResource CardShadow}"
                    Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                            Background="{DynamicResource PageHeaderIconRing}"
                            BorderBrush="{DynamicResource PageHeaderIconBorder}"
                            BorderThickness="1"
                            Margin="0,0,14,0">
                        <md:PackIcon Kind="ShieldCheck" Width="24" Height="24"
                                     Foreground="{DynamicResource TextAccent}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="txtProtectionHeadline"
                                   Text="Votre ordinateur est protégé"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDark}"/>
                        <TextBlock x:Name="txtProtectionStatus"
                                   Text="Les définitions sont à jour."
                                   FontSize="12"
                                   Foreground="{DynamicResource SuccessGreen}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <md:PackIcon Grid.Column="2" Kind="TrendingUp"
                                 Width="24" Height="24"
                                 Foreground="{DynamicResource AlertGoldLight}"
                                 VerticalAlignment="Center"
                                 Opacity="0.85"/>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="1"
                         Columns="4"
                         Margin="24,12,24,8">

                <Border Margin="0,0,6,0" CornerRadius="12"
                        Background="{DynamicResource CardBg}"
                        Effect="{DynamicResource CardShadow}"
                        Cursor="Hand" Tag="{x:Static strings:OptiscanStrings+PanelIds.Clean}"
                        MouseLeftButtonUp="ActionCard_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,14">
                        <Border Width="48" Height="48" CornerRadius="24"
                                Background="{DynamicResource SurfaceBg}"
                                HorizontalAlignment="Center" Margin="0,0,0,10">
                            <md:PackIcon Kind="Broom" Width="26" Height="26"
                                         Foreground="{DynamicResource AlertGoldLight}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="NETTOYER" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextDark}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Fichiers temporaires" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Margin="3,0,3,0" CornerRadius="12"
                        Background="{DynamicResource CardBg}"
                        Effect="{DynamicResource CardShadow}"
                        Cursor="Hand" Tag="{x:Static strings:OptiscanStrings+PanelIds.Antivirus}"
                        MouseLeftButtonUp="ActionCard_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,14">
                        <Border Width="48" Height="48" CornerRadius="24"
                                Background="{DynamicResource SurfaceBg}"
                                HorizontalAlignment="Center" Margin="0,0,0,10">
                            <md:PackIcon Kind="ShieldCheck" Width="26" Height="26"
                                         Foreground="{DynamicResource SuccessGreen}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="ANTIVIRUS" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextDark}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Lancer une analyse" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Margin="3,0,3,0" CornerRadius="12"
                        Background="{DynamicResource CardBg}"
                        Effect="{DynamicResource CardShadow}"
                        Cursor="Hand" Tag="{x:Static strings:OptiscanStrings+PanelIds.History}"
                        MouseLeftButtonUp="ActionCard_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,14">
                        <Border Width="48" Height="48" CornerRadius="24"
                                Background="{DynamicResource SurfaceBg}"
                                HorizontalAlignment="Center" Margin="0,0,0,10">
                            <md:PackIcon Kind="History" Width="26" Height="26"
                                         Foreground="{DynamicResource TextAccent}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="HISTORIQUE" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextDark}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Voir l'historique" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Margin="6,0,0,0" CornerRadius="12"
                        Background="{DynamicResource CardBg}"
                        Effect="{DynamicResource CardShadow}"
                        Cursor="Hand" Tag="{x:Static strings:OptiscanStrings+ActionIds.Update}"
                        MouseLeftButtonUp="ActionCard_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,14">
                        <Border Width="48" Height="48" CornerRadius="24"
                                Background="{DynamicResource SurfaceBg}"
                                HorizontalAlignment="Center" Margin="0,0,0,10">
                            <md:PackIcon Kind="Refresh" Width="26" Height="26"
                                         Foreground="{DynamicResource TextAccent}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="MISE À JOUR" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextDark}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="ClamAV + règles YARA" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Ligne du bas : s'étire jusqu'au bas de la zone Accueil (plus de bande grise vide) -->
            <Grid Grid.Row="2" Margin="24,0,24,12" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource CardBg}"
                        CornerRadius="12" Padding="16,14"
                        Effect="{DynamicResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Statistiques de protection"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextDark}"/>
                            <TextBlock Text="Synthèse textuelle — 30 derniers jours"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}"
                                       Margin="0,2,0,2"/>
                            <TextBlock x:Name="txtProtectionStatsUpdated"
                                       FontSize="10" Foreground="{DynamicResource TextMuted}"
                                       Margin="0,0,0,8"/>
                        </StackPanel>
                        <Border Grid.Row="1"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceBg}"
                                Padding="12,10"
                                MinHeight="72">
                            <TextBlock x:Name="txtProtectionStatsBody"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextDark}"
                                       VerticalAlignment="Top"
                                       LineHeight="20"
                                       Text="Chargement des statistiques…"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource CardBg}"
                        CornerRadius="12" Padding="16,14"
                        Effect="{DynamicResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                        <TextBlock Text="Recommandations"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDark}" Margin="0,0,0,10"/>

                        <Border x:Name="brRecSignatures" Background="{DynamicResource SuccessBg}"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon x:Name="icRecSignatures" Kind="CheckCircle" Width="16" Height="16"
                                             Foreground="{DynamicResource SuccessGreen}"
                                             VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtRecSignatures" Text="Moteurs antivirus"
                                           FontSize="12" Foreground="{DynamicResource SuccessGreen}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="brRecHygiene" Background="{DynamicResource AlertBg}"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon x:Name="icRecHygiene" Kind="Broom" Width="16" Height="16"
                                             Foreground="{DynamicResource AlertGoldLight}"
                                             VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtRecHygiene" Text="Nettoyage disque"
                                           FontSize="12" Foreground="{DynamicResource AlertGold}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="brRecActivity" Background="{DynamicResource SurfaceBg}"
                                CornerRadius="8" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon x:Name="icRecActivity" Kind="History" Width="16" Height="16"
                                             Foreground="{DynamicResource SuccessGreen}"
                                             VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtRecActivity" Text="Analyses"
                                           FontSize="12" Foreground="{DynamicResource TextMedium}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="4"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource CardBg}"
                        CornerRadius="12" Padding="16,14"
                        Effect="{DynamicResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                        <TextBlock Text="État de protection"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDark}"
                                   Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <md:PackIcon Kind="ShieldCheck" Width="14" Height="14"
                                         Foreground="{DynamicResource SuccessGreen}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="ClamAV"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtOverviewClamAvStatus" Grid.Column="2"
                                       Text="Actif" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessGreen}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <md:PackIcon Kind="Dna" Width="14" Height="14"
                                         Foreground="{DynamicResource AccentBlue}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Règles YARA"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtOverviewYaraCount" Grid.Column="2"
                                       Text="—" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBlue}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Rectangle Height="1" Fill="{DynamicResource BorderColor}" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <md:PackIcon Kind="ClockOutline" Width="16" Height="16"
                                         Foreground="{DynamicResource TextMuted}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Dernière analyse"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextDark}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="txtLastScan"
                                   Text="Jamais"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMedium}"
                                   Margin="24,0,0,12"/>

                        <TextBlock Text="Signatures et règles"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDark}"
                                   Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="YARA" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="txtOverviewYaraPackVer" Text="—"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBlue}" Margin="0,2,0,0"/>
                                <TextBlock Text="Dernière MAJ" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="txtOverviewYaraPackMaj" Text="—"
                                           FontSize="11" Foreground="{DynamicResource TextDark}"/>
                            </StackPanel>

                            <Rectangle Grid.Column="1" Width="1" Margin="4,0"
                                       Fill="{DynamicResource BorderColor}" VerticalAlignment="Stretch"/>

                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="ClamAV" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="txtOverviewClamDbVer" Text="—"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource AlertGold}" Margin="0,2,0,0"/>
                                <TextBlock Text="Dernière MAJ" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="txtOverviewClamDbMaj" Text="—"
                                           FontSize="11" Foreground="{DynamicResource TextDark}"/>
                            </StackPanel>
                        </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
    </Grid>
</UserControl>
