<UserControl x:Class="optiSCAN.Views.OverviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource ContentBg}">
        <StackPanel Margin="24,20,24,24">

            <!-- ── Bannière de protection ─────────────────────────────────── -->
            <Border Background="{DynamicResource CardBg}"
                    CornerRadius="12" Padding="20,16"
                    Margin="0,0,0,16"
                    Effect="{DynamicResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icône verte -->
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                            Background="{DynamicResource SuccessBg}" Margin="0,0,16,0">
                        <md:PackIcon Kind="CheckCircle" Width="26" Height="26"
                                     Foreground="{DynamicResource SuccessGreen}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Texte -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Votre ordinateur est protégé"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDark}"/>
                        <TextBlock x:Name="txtProtectionStatus"
                                   Text="Les définitions sont à jour."
                                   FontSize="12"
                                   Foreground="{DynamicResource SuccessGreen}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Icône tendance -->
                    <md:PackIcon Grid.Column="2" Kind="TrendingUp"
                                 Width="28" Height="28"
                                 Foreground="{DynamicResource AlertGoldLight}"
                                 VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── 4 Cartes d'action ──────────────────────────────────────── -->
            <UniformGrid Columns="4" Margin="0,0,0,16">

                <!-- NETTOYER -->
                <Border Margin="0,0,8,0" CornerRadius="12"
                        Background="{DynamicResource CardBg}"
                        Effect="{DynamicResource CardShadow}"
                        Cursor="Hand" Tag="Clean"
                        MouseLeftButtonUp="ActionCard_Click">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="20,18">
                        <Border Width="52" Height="52" CornerRadius="26"
                                Background="{DynamicResource SurfaceBg}"
                                HorizontalAlignment="Center" Margin="0,0,0,12">
                            <md:PackIcon Kind="Broom" Width="28" Height="28"
                                         Foreground="{DynamicResource AlertGoldLight}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="NETTOYER" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextDark}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Fichiers temporaires" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ANTIVIRUS -->
                <Border Margin="4,0,4,0" CornerRadius="12"
                        Background="{DynamicResource CardBg}"
                        Effect="{DynamicResource CardShadow}"
                        Cursor="Hand" Tag="Antivirus"
                        MouseLeftButtonUp="ActionCard_Click">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="20,18">
                        <Border Width="52" Height="52" CornerRadius="26"
                                Background="{DynamicResource SurfaceBg}"
                                HorizontalAlignment="Center" Margin="0,0,0,12">
                            <md:PackIcon Kind="ShieldCheck" Width="28" Height="28"
                                         Foreground="{DynamicResource SuccessGreen}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="ANTIVIRUS" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextDark}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Lancer une analyse" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- HISTORIQUE -->
                <Border Margin="4,0,4,0" CornerRadius="12"
                        Background="{DynamicResource CardBg}"
                        Effect="{DynamicResource CardShadow}"
                        Cursor="Hand" Tag="History"
                        MouseLeftButtonUp="ActionCard_Click">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="20,18">
                        <Border Width="52" Height="52" CornerRadius="26"
                                Background="{DynamicResource SurfaceBg}"
                                HorizontalAlignment="Center" Margin="0,0,0,12">
                            <md:PackIcon Kind="History" Width="28" Height="28"
                                         Foreground="{DynamicResource PrimaryBlue}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="HISTORIQUE" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextDark}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Voir l’historique" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- MISE À JOUR -->
                <Border Margin="8,0,0,0" CornerRadius="12"
                        Background="{DynamicResource CardBg}"
                        Effect="{DynamicResource CardShadow}"
                        Cursor="Hand" Tag="Update"
                        MouseLeftButtonUp="ActionCard_Click">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="20,18">
                        <Border Width="52" Height="52" CornerRadius="26"
                                Background="{DynamicResource SurfaceBg}"
                                HorizontalAlignment="Center" Margin="0,0,0,12">
                            <md:PackIcon Kind="Refresh" Width="28" Height="28"
                                         Foreground="{DynamicResource PrimaryBlue}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="MISE À JOUR" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextDark}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="ClamAV + règles YARA" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- ── Ligne inférieure : Statistiques | Recommandations | Info ─ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- Statistiques de Protection (graphique) -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBg}"
                        CornerRadius="12" Padding="18,16"
                        Effect="{DynamicResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="Statistiques de protection"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDark}"/>
                        <TextBlock Text="Tendance sur 30 jours (bientôt disponible)"
                                   FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   Margin="0,2,0,10"/>

                        <Border MinHeight="128" CornerRadius="8"
                                Background="{DynamicResource SurfaceBg}"
                                Padding="14,12">
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center"
                                       LineHeight="18"
                                       Text="Les graphiques seront dérivés de votre historique d’analyses. Pour l’instant, consultez l’onglet Historique pour chaque session (fichiers parcourus, durée, menaces)."/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Recommandations d'Action -->
                <Border Grid.Column="2"
                        Background="{DynamicResource CardBg}"
                        CornerRadius="12" Padding="18,16"
                        Effect="{DynamicResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="Recommandations"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextDark}" Margin="0,0,0,12"/>

                        <Border Background="{DynamicResource SuccessBg}"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="CheckCircle" Width="16" Height="16"
                                             Foreground="{DynamicResource SuccessGreen}"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text=" Système à jour"
                                           FontSize="12" Foreground="{DynamicResource SuccessGreen}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource AlertBg}"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Broom" Width="16" Height="16"
                                             Foreground="{DynamicResource AlertGoldLight}"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text=" Nettoyage recommandé"
                                           FontSize="12" Foreground="{DynamicResource AlertGold}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceBg}"
                                CornerRadius="8" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="History" Width="16" Height="16"
                                             Foreground="{DynamicResource SuccessGreen}"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text=" Détail des analyses dans Historique"
                                           FontSize="12" Foreground="{DynamicResource TextMedium}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3 Cartes info rapides -->
                <StackPanel Grid.Column="4" >

                    <!-- État Antivirus (ClamAV + YARA) -->
                    <Border Background="{DynamicResource CardBg}"
                            CornerRadius="12" Padding="16,14"
                            Effect="{DynamicResource CardShadow}"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="État Antivirus"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextDark}"
                                       Margin="0,0,0,10"/>

                            <!-- ClamAV row -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <md:PackIcon Kind="ShieldCheck" Width="14" Height="14"
                                             Foreground="{DynamicResource SuccessGreen}"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="ClamAV"
                                           FontSize="11" Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtOverviewClamAvStatus" Grid.Column="2"
                                           Text="Actif" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessGreen}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- YARA row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <md:PackIcon Kind="Dna" Width="14" Height="14"
                                             Foreground="{DynamicResource PrimaryBlue}"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Règles YARA"
                                           FontSize="11" Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtOverviewYaraCount" Grid.Column="2"
                                           Text="—" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBlue}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Dernière analyse -->
                    <Border Background="{DynamicResource CardBg}"
                            CornerRadius="12" Padding="16,12"
                            Effect="{DynamicResource CardShadow}"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <md:PackIcon Kind="ClockOutline" Width="18" Height="18"
                                             Foreground="{DynamicResource TextMuted}"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Dernière analyse"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDark}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtLastScan"
                                       Text="Jamais"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextMedium}"
                                       Margin="26,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Signatures : YARA | ClamAV -->
                    <Border Background="{DynamicResource CardBg}"
                            CornerRadius="12" Padding="16,12"
                            Effect="{DynamicResource CardShadow}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <md:PackIcon Kind="DatabaseCheck" Width="18" Height="18"
                                             Foreground="{DynamicResource TextMuted}"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Signatures et règles"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDark}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Margin="4,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="YARA" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock x:Name="txtOverviewYaraPackVer" Text="—"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBlue}" Margin="0,2,0,0"/>
                                    <TextBlock Text="Dernière MAJ" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="txtOverviewYaraPackMaj" Text="—"
                                               FontSize="11" Foreground="{DynamicResource TextDark}"/>
                                </StackPanel>

                                <Rectangle Grid.Column="1" Width="1" Margin="4,0"
                                           Fill="{DynamicResource BorderColor}" VerticalAlignment="Stretch"/>

                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock Text="ClamAV" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock x:Name="txtOverviewClamDbVer" Text="—"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource AlertGold}" Margin="0,2,0,0"/>
                                    <TextBlock Text="Dernière MAJ" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="txtOverviewClamDbMaj" Text="—"
                                               FontSize="11" Foreground="{DynamicResource TextDark}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
