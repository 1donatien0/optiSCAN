<UserControl x:Class="optiSCAN.Views.AntivirusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="920"
             AllowDrop="True"
             DragOver="AntivirusPanel_DragOver"
             Drop="AntivirusPanel_Drop">
    <Grid>
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <Border CornerRadius="10" Padding="14" Margin="5"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Background="{DynamicResource CardBg}">
                        <StackPanel>
                            <TextBlock Text="LANCER UNE ANALYSE" Foreground="{DynamicResource AlertGold}"
                                       FontFamily="Segoe UI" FontSize="10"
                                       FontWeight="Bold" Margin="0,0,0,12"/>

                            <Border CornerRadius="6" Padding="10,6" Margin="0,0,0,10" Background="{DynamicResource SurfaceBg}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="FileSearch" Width="14" Height="14"
                                                 Foreground="{DynamicResource SuccessGreen}" Margin="0,0,8,0"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock x:Name="antivirusYaraStatus" Text="YARA : chargement..."
                                               Foreground="{DynamicResource TextSecondary}" FontFamily="Segoe UI"
                                               FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="btnQuickScan" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding QuickScanCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,2"
                                    ToolTip="Analyse rapide — raccourci F5">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Flash" Width="14" Height="14"
                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Analyse rapide  (F5)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Démarrage, dossiers Windows et profil utilisateur (équivalent d’une analyse rapide courante)" Foreground="{DynamicResource TextSecondary}"
                                       FontFamily="Segoe UI" FontSize="10" Margin="2,0,0,10" TextWrapping="Wrap"/>

                            <Button x:Name="btnFullScan" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding FullScanCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Magnify" Width="14" Height="14"
                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Analyse complète" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Tous les disques fixes (peut être long)" Foreground="{DynamicResource TextSecondary}"
                                       FontFamily="Segoe UI" FontSize="10" Margin="2,0,0,10"/>

                            <Button x:Name="btnBrowseFolder" Style="{StaticResource PrimaryButton}"
                                    Click="BrowseFolder_Click" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="FolderOpenOutline" Width="14" Height="14"
                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Analyser un dossier" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnBrowseFile" Style="{StaticResource PrimaryButton}"
                                    Click="BrowseFile_Click" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="FileDocumentOutline" Width="14" Height="14"
                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Analyser un fichier" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Zone Drag & Drop -->
                            <Grid Margin="0,8,0,8" Height="62">
                                <Rectangle RadiusX="8" RadiusY="8"
                                           Stroke="{DynamicResource BorderStrong}"
                                           StrokeDashArray="4,3"
                                           StrokeThickness="1.5"
                                           Fill="{DynamicResource SurfaceBg}"/>
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <md:PackIcon Kind="TrayArrowDown" Width="20" Height="20"
                                                 Foreground="{DynamicResource TextMuted}"
                                                 HorizontalAlignment="Center"/>
                                    <TextBlock Text="Glisser-déposer ici"
                                               FontFamily="Segoe UI" FontSize="10"
                                               Foreground="{DynamicResource TextMuted}"
                                               HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Separator Background="{DynamicResource BorderColor}" Margin="0,6"/>

                            <Button x:Name="btnStopScan" Style="{StaticResource DangerButton}"
                                    Command="{Binding StopScanCommand}" IsEnabled="{Binding CanStop}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="StopCircleOutline" Width="14" Height="14"
                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Interrompre l’analyse" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="10" Padding="14" Margin="5,4,5,5"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Background="{DynamicResource CardBg}">
                        <StackPanel>
                            <TextBlock Text="STATISTIQUES" Foreground="{DynamicResource AlertGold}"
                                       FontFamily="Segoe UI" FontSize="10"
                                       FontWeight="Bold" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <md:PackIcon Kind="Folder" Width="13" Height="13"
                                                 Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Fichiers analysés" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock x:Name="antivirusFilesScanned" Grid.Column="1" Text="{Binding FilesScanned}"
                                           Foreground="{DynamicResource AlertGold}" FontWeight="Bold" FontSize="16"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <md:PackIcon Kind="Alert" Width="13" Height="13"
                                                 Foreground="{DynamicResource AlertGold}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Menaces trouvées" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock x:Name="antivirusThreatsFound" Grid.Column="1" Text="{Binding ThreatsFound}"
                                           Foreground="{DynamicResource DangerRed}" FontWeight="Bold" FontSize="16"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <md:PackIcon Kind="Lock" Width="13" Height="13"
                                                 Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                                    <TextBlock Text="En quarantaine" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock x:Name="antivirusQuarantineCount" Grid.Column="1"
                                           Text="{Binding QuarantineTotalCount, StringFormat=N0}"
                                           Foreground="{DynamicResource WarningOrange}" FontWeight="Bold" FontSize="16"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <md:PackIcon Kind="Dna" Width="13" Height="13"
                                                 Foreground="{DynamicResource SuccessGreen}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Règles YARA" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock x:Name="antivirusYaraCount" Grid.Column="1" Text="0"
                                           Foreground="{DynamicResource SuccessGreen}" FontWeight="Bold" FontSize="16"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Separator Background="{DynamicResource BorderColor}" Margin="0,10"/>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <md:PackIcon Kind="ClockOutline" Width="12" Height="12"
                                                 Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Dernier scan" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                </StackPanel>
                                <TextBlock x:Name="antivirusLastScan" Grid.Column="1" Text="—"
                                           Foreground="{DynamicResource TextDark}" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TabControl x:Name="antivirusMainTabs" Grid.Column="1" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Background="{DynamicResource CardBg}">
                    <TabItem Foreground="{DynamicResource TextSecondary}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Radar" Width="14" Height="14"
                                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Analyse en cours" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Border Padding="12,10" Background="{DynamicResource CardBg}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Bandeau « analyse en cours » (style suite antivirus) -->
                                <Border Grid.Row="0" CornerRadius="10" Padding="14,12" Margin="0,0,0,10"
                                        BorderBrush="{DynamicResource PrimaryBlue}" BorderThickness="2"
                                        Background="{DynamicResource AccentBg}"
                                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <md:PackIcon Kind="ShieldSearch" Width="22" Height="22"
                                                         Foreground="{DynamicResource PrimaryBlue}" Margin="0,0,10,0"
                                                         VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Analyse antivirus en cours"
                                                           FontSize="16" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextDark}"/>
                                                <TextBlock Text="Les moteurs ClamAV et YARA parcourent vos fichiers. Vous pouvez interrompre à tout moment."
                                                           FontSize="11" Foreground="{DynamicResource TextMuted}"
                                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <ProgressBar Height="10" Margin="0,0,0,8"
                                                     Value="{Binding ProgressValue}"
                                                     Minimum="0" Maximum="100"
                                                     IsIndeterminate="{Binding IsIndeterminate}"
                                                     Foreground="{DynamicResource PrimaryBlue}"
                                                     Background="{DynamicResource BorderColor}"/>

                                        <TextBlock Text="{Binding ScanProgressDetail}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextDark}" Margin="0,0,0,6"/>

                                        <TextBlock Text="Élément en cours :"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding CurrentScanItem}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextDark}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding CurrentScanItem}"/>

                                        <Separator Margin="0,10,0,8" Background="{DynamicResource BorderColor}"/>

                                        <TextBlock Text="{Binding StatusMessage}"
                                                   FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- État hors analyse -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="antivirusStatusMessage" Text="{Binding StatusMessage}"
                                               Foreground="{DynamicResource TextDark}" FontFamily="Segoe UI"
                                               FontSize="12" TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="antivirusSummary" Grid.Column="1"
                                               Foreground="{DynamicResource TextSecondary}" FontFamily="Segoe UI"
                                               FontSize="11" VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                </Grid>

                                <Border Grid.Row="1" CornerRadius="6" Padding="10,7"
                                        Margin="0,0,0,8" Background="{DynamicResource SurfaceBg}">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="ChartBar" Width="13" Height="13"
                                                     Foreground="{DynamicResource TextSecondary}" Margin="0,0,5,0"
                                                     VerticalAlignment="Center"/>
                                        <TextBlock Text="Fichiers analysés :"
                                                   Foreground="{DynamicResource TextSecondary}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="antivirusRealtimeFiles" Text="{Binding FilesScanned, StringFormat=N0}"
                                                   Foreground="{DynamicResource TextDark}" FontWeight="Bold"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Margin="0,0,20,0"/>
                                        <md:PackIcon Kind="Alert" Width="13" Height="13"
                                                     Foreground="{DynamicResource AlertGold}" Margin="0,0,5,0"
                                                     VerticalAlignment="Center"/>
                                        <TextBlock Text="Menaces :"
                                                   Foreground="{DynamicResource TextSecondary}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="antivirusRealtimeThreats" Text="{Binding ThreatsFound}"
                                                   Foreground="{DynamicResource DangerRed}" FontWeight="Bold"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                        <Border x:Name="threatsBadge" Visibility="Collapsed"
                                                CornerRadius="8" Padding="6,1" Margin="10,0,0,0"
                                                Background="{DynamicResource DangerRed}">
                                            <TextBlock x:Name="threatsBadgeText"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextDark}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <DataGrid x:Name="antivirusThreatsGrid" ItemsSource="{Binding Threats}"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" Grid.Row="2"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="True" Background="{DynamicResource AppBg}" RowBackground="{DynamicResource AppBg}"
                                          AlternatingRowBackground="{DynamicResource HeaderBg}" Foreground="{DynamicResource TextDark}"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{DynamicResource BorderSubtle}" HeadersVisibility="Column"
                                          BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" SelectionMode="Single"
                                          ColumnHeaderStyle="{StaticResource DgHeader}"
                                          RowStyle="{StaticResource DgRow}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Fichier" Binding="{Binding FileName}" Width="130"/>
                                        <DataGridTextColumn Header="Menace" Binding="{Binding VirusName}" Width="*"/>
                                        <DataGridTextColumn Header="Source" Binding="{Binding DetectedBy}" Width="70"/>
                                        <DataGridTextColumn Header="Heure" Binding="{Binding DetectedAt, StringFormat='HH:mm:ss'}" Width="60"/>
                                        <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="70"/>
                                        <DataGridTemplateColumn Header="Nettoyer" Width="270">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="2,1">
                                                        <Button Margin="0,0,4,0" Tag="{Binding FilePath}"
                                                                Click="BtnQuarantineThreat_Click"
                                                                Background="{DynamicResource PrimaryBlue}" Foreground="{DynamicResource TextDark}"
                                                                FontSize="10" Padding="7,4" Cursor="Hand">
                                                            <StackPanel Orientation="Horizontal">
                                                                <md:PackIcon Kind="ShieldLock" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Quarantaine" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Margin="0,0,4,0" Tag="{Binding FilePath}"
                                                                Click="BtnIgnoreThreat_Click"
                                                                Background="{DynamicResource WarningOrange}" Foreground="{DynamicResource TextDark}"
                                                                FontSize="10" Padding="7,4" Cursor="Hand"
                                                                ToolTip="Ajouter aux exclusions — ce fichier ne sera plus jamais détecté">
                                                            <StackPanel Orientation="Horizontal">
                                                                <md:PackIcon Kind="EyeOff" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Ignorer" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Tag="{Binding FilePath}"
                                                                Click="BtnDeleteThreat_Click"
                                                                Background="{DynamicResource DangerRed}" Foreground="{DynamicResource TextDark}"
                                                                FontSize="10" Padding="7,4" Cursor="Hand">
                                                            <StackPanel Orientation="Horizontal">
                                                                <md:PackIcon Kind="TrashCanOutline" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Supprimer" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Grid.Row="3" Orientation="Horizontal"
                                            HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button x:Name="btnQuarantineAll" Style="{StaticResource WarningButton}"
                                            Command="{Binding QuarantineAllCommand}" Padding="12,6">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="ShieldLock" Width="13" Height="13"
                                                         Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Tout mettre en quarantaine"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Foreground="{DynamicResource TextSecondary}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="LockOutline" Width="14" Height="14"
                                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Quarantaine" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Border Padding="12" Background="{DynamicResource CardBg}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="quarantineGrid"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" Grid.Row="0"
                                          ItemsSource="{Binding QuarantineEntries}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="True" Background="{DynamicResource AppBg}" RowBackground="{DynamicResource AppBg}"
                                          AlternatingRowBackground="{DynamicResource HeaderBg}" Foreground="{DynamicResource TextDark}"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{DynamicResource BorderSubtle}" BorderBrush="{DynamicResource BorderColor}"
                                          BorderThickness="0" ColumnHeaderStyle="{StaticResource DgHeader}"
                                          RowStyle="{StaticResource DgRow}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Fichier" Binding="{Binding FileName}" Width="170"/>
                                        <DataGridTextColumn Header="Virus" Binding="{Binding VirusName}" Width="*"/>
                                        <DataGridTextColumn Header="Taille" Binding="{Binding SizeDisplay}" Width="75"/>
                                        <DataGridTextColumn Header="Quarantaine" Binding="{Binding QuarantinedAt, StringFormat='dd/MM HH:mm'}" Width="110"/>
                                        <DataGridTemplateColumn Header="Actions" Width="175">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="2,1">
                                                        <Button Margin="0,0,4,0" Tag="{Binding Id}"
                                                                Click="BtnRestoreFromQuarantine_Click"
                                                                Background="{DynamicResource PrimaryBlue}" Foreground="{DynamicResource TextDark}"
                                                                FontSize="10" Padding="7,4" Cursor="Hand">
                                                            <StackPanel Orientation="Horizontal">
                                                                <md:PackIcon Kind="UndoVariant" Width="12" Height="12" Margin="0,0,4,0"/>
                                                                <TextBlock Text="Restaurer"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Tag="{Binding Id}"
                                                                Click="BtnDeleteFromQuarantine_Click"
                                                                Background="{DynamicResource DangerRed}" Foreground="{DynamicResource TextDark}"
                                                                FontSize="10" Padding="7,4" Cursor="Hand">
                                                            <StackPanel Orientation="Horizontal">
                                                                <md:PackIcon Kind="TrashCanOutline" Width="12" Height="12" Margin="0,0,4,0"/>
                                                                <TextBlock Text="Supprimer"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding QuarantinePagingStatus}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <Button HorizontalAlignment="Left" Padding="12,6"
                                            Command="{Binding LoadMoreQuarantineCommand}"
                                            Style="{StaticResource PrimaryButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="ChevronDown" Width="14" Height="14"
                                                         Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Charger plus d'entrées" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <Button Grid.Row="2" x:Name="btnPurgeQuarantine" Style="{StaticResource DangerButton}"
                                        Command="{Binding PurgeQuarantineCommand}" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="TrashCanOutline" Width="14" Height="14"
                                                     Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Vider toute la quarantaine" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Foreground="{DynamicResource TextSecondary}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="History" Width="14" Height="14"
                                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Historique" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Border Padding="12" Background="{DynamicResource CardBg}">
                            <DataGrid x:Name="antivirusHistoryGrid"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" Background="{DynamicResource AppBg}" RowBackground="{DynamicResource AppBg}"
                                      AlternatingRowBackground="{DynamicResource HeaderBg}" Foreground="{DynamicResource TextDark}"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource BorderSubtle}" BorderBrush="{DynamicResource BorderColor}"
                                      BorderThickness="0" ColumnHeaderStyle="{StaticResource DgHeader}"
                                      RowStyle="{StaticResource DgRow}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding StartedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="130"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" Width="110"/>
                                    <DataGridTextColumn Header="Cible" Binding="{Binding TargetPath}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DgCellTextEllipsis}">
                                                <Setter Property="ToolTip" Value="{Binding TargetPath}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Fichiers" Binding="{Binding FilesScanned, StringFormat=N0}" Width="82"/>
                                    <DataGridTextColumn Header="Durée" Binding="{Binding DurationDisplay}" Width="100"/>
                                    <DataGridTextColumn Header="Résultat" Binding="{Binding ThreatsBadge}" Width="160">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DgCellTextEllipsis}">
                                                <Setter Property="ToolTip" Value="{Binding ThreatsBadge}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>

                    <TabItem Foreground="{DynamicResource TextSecondary}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="DatabaseRefresh" Width="14" Height="14"
                                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Signatures" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Border Padding="16" Background="{DynamicResource CardBg}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Versions installées"
                                               Foreground="{DynamicResource TextDark}" FontFamily="Segoe UI"
                                               FontSize="16" FontWeight="SemiBold"
                                               Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- YARA (gauche) -->
                                        <Border Grid.Column="0" CornerRadius="8" Padding="12,10" Margin="0,0,10,0"
                                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Background="{DynamicResource SurfaceBg}">
                                            <StackPanel>
                                                <TextBlock Text="RÈGLES YARA" Foreground="{DynamicResource TextMuted}"
                                                           FontSize="10" FontWeight="Bold"/>
                                                <TextBlock x:Name="sigYaraVersion" Foreground="{DynamicResource PrimaryBlue}"
                                                           FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                                                <TextBlock Text="Dernière MAJ" Foreground="{DynamicResource TextMuted}"
                                                           FontSize="10" FontWeight="SemiBold" Margin="0,8,0,2"/>
                                                <TextBlock x:Name="sigYaraLastMaj" Foreground="{DynamicResource TextDark}"
                                                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <Rectangle Grid.Column="1" Width="1" Margin="0,6"
                                                   Fill="{DynamicResource BorderColor}" VerticalAlignment="Stretch"/>

                                        <!-- ClamAV (droite) -->
                                        <Border Grid.Column="2" CornerRadius="8" Padding="12,10" Margin="10,0,0,0"
                                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Background="{DynamicResource SurfaceBg}">
                                            <StackPanel>
                                                <TextBlock Text="CLAMAV" Foreground="{DynamicResource TextMuted}"
                                                           FontSize="10" FontWeight="Bold"/>
                                                <TextBlock x:Name="sigClamVersion" Foreground="{DynamicResource AlertGold}"
                                                           FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                                                <TextBlock Text="Dernière MAJ" Foreground="{DynamicResource TextMuted}"
                                                           FontSize="10" FontWeight="SemiBold" Margin="0,8,0,2"/>
                                                <TextBlock x:Name="sigClamLastMaj" Foreground="{DynamicResource TextDark}"
                                                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Boutons + barre de progression -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Ligne de boutons -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button x:Name="btnManualUpdateSignatures"
                                                    Style="{StaticResource SuccessButton}"
                                                    Click="BtnManualUpdateSignatures_Click"
                                                    Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <md:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Mettre à jour les signatures" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button x:Name="btnStopUpdateSignatures"
                                                    Style="{StaticResource DangerButton}"
                                                    Click="BtnStopUpdateSignatures_Click"
                                                    Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal">
                                                    <md:PackIcon Kind="StopCircleOutline" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Arrêter" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <!-- Barre de progression intégrée (visible pendant la MAJ) -->
                                        <ProgressBar x:Name="sigUpdateProgressBar" Grid.Row="1"
                                                     Height="4" IsIndeterminate="True"
                                                     Foreground="{DynamicResource SuccessGreen}"
                                                     Background="{DynamicResource SurfaceBg}"
                                                     BorderBrush="Transparent"
                                                     Visibility="Collapsed">
                                            <ProgressBar.Template>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Grid>
                                                        <Border x:Name="PART_Track" CornerRadius="2"
                                                                Background="{TemplateBinding Background}"/>
                                                        <Border x:Name="PART_Indicator" CornerRadius="2"
                                                                Background="{TemplateBinding Foreground}"
                                                                HorizontalAlignment="Left"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </ProgressBar.Template>
                                        </ProgressBar>
                                    </Grid>
                                </StackPanel>

                                <Border Grid.Row="1" CornerRadius="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                        Background="{DynamicResource AppBg}">
                                    <!-- Défilement uniquement dans le TextBox (ScrollViewer externe + ScrollToEnd() = conflit de scroll). -->
                                    <TextBox x:Name="signatureLog" Margin="2" IsReadOnly="True" Background="Transparent"
                                             Foreground="{DynamicResource SuccessGreen}" FontFamily="Consolas" FontSize="11"
                                             TextWrapping="Wrap" BorderThickness="0" Padding="12,8"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                                </Border>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>
            
    </Grid>
</UserControl>
