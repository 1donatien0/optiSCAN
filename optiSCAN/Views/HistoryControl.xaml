<UserControl x:Class="optiSCAN.Views.HistoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Background="{DynamicResource ContentBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── En-tête ── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="24,20,24,16">
            <TextBlock Text="Historique"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextDark}"
                       VerticalAlignment="Center"/>
            <Button Content="Exporter HTML"
                    Click="BtnExportHtml_Click"
                    Height="36" Margin="16,0,0,0"
                    Padding="14,0"
                    Cursor="Hand"
                    ToolTip="Rapport HTML (historique, quarantaine, menaces actives)"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    Background="{DynamicResource CardBg}"
                    Foreground="{DynamicResource TextDark}"/>
            <Button Content="Exporter PDF (sélection)"
                    Click="BtnExportSelectedPdf_Click"
                    Height="36" Margin="8,0,0,0"
                    Padding="14,0"
                    Cursor="Hand"
                    ToolTip="PDF de la ligne sélectionnée dans Scans antivirus"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    Background="{DynamicResource CardBg}"
                    Foreground="{DynamicResource TextDark}"/>
            <Button Content="Ouvrir l'antivirus"
                    Click="BtnOpenAntivirus_Click"
                    Height="36" Margin="8,0,0,0"
                    Padding="14,0"
                    Cursor="Hand"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource PrimaryBlue}"
                    Background="{DynamicResource CardBg}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <StackPanel Orientation="Horizontal"
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center">
                                <md:PackIcon Kind="ShieldCheck" Width="15" Height="15"
                                             Foreground="{DynamicResource PrimaryBlue}"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text=" Ouvrir l'antivirus"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBlue}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource AccentBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- ── Corps : onglets + grille ── -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBg}"
                CornerRadius="12" Margin="24,0,24,24"
                Effect="{DynamicResource CardShadow}">
            <TabControl Background="Transparent" BorderThickness="0"
                        Padding="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground"  Value="{DynamicResource TextMuted}"/>
                        <Setter Property="FontSize"    Value="13"/>
                        <Setter Property="Padding"     Value="20,12"/>
                        <Setter Property="Background"  Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="bg" Background="Transparent"
                                            BorderBrush="{DynamicResource PrimaryBlue}"
                                            BorderThickness="0,0,0,2">
                                        <ContentPresenter ContentSource="Header"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Center"
                                                          RecognizesAccessKey="True"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextDark}"/>
                                            <Setter TargetName="bg" Property="BorderThickness"
                                                    Value="0,0,0,2"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter TargetName="bg" Property="BorderThickness"
                                                    Value="0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- Scans antivirus -->
                <TabItem Header="Scans antivirus">
                    <DataGrid x:Name="dgScanHistory"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderSubtle}"
                              Background="Transparent"
                              BorderThickness="0"
                              ColumnHeaderStyle="{DynamicResource DgHeader}"
                              RowStyle="{DynamicResource DgRow}"
                              AlternationCount="2"
                              VirtualizingPanel.IsVirtualizing="True"
                              Margin="0,0,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding StartedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                Width="155"/>
                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding TypeDisplay}"
                                                Width="130"/>
                            <DataGridTextColumn Header="Cible"
                                                Binding="{Binding TargetPath}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DgCellTextEllipsis}">
                                        <Setter Property="ToolTip" Value="{Binding TargetPath}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Fichiers"
                                                Binding="{Binding FilesScanned, StringFormat={}{0:N0}}"
                                                Width="90"/>
                            <DataGridTextColumn Header="Durée"
                                                Binding="{Binding DurationDisplay}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Résultat"
                                                Binding="{Binding ThreatsBadge}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DgCellTextEllipsis}">
                                        <Setter Property="ToolTip" Value="{Binding ThreatsBadge}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Nettoyages système -->
                <TabItem Header="Nettoyages système">
                    <DataGrid x:Name="dgCleanHistory"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderSubtle}"
                              Background="Transparent"
                              BorderThickness="0"
                              ColumnHeaderStyle="{DynamicResource DgHeader}"
                              RowStyle="{DynamicResource DgRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding DateDisplay}"
                                                Width="155"/>
                            <DataGridTextColumn Header="Cibles"
                                                Binding="{Binding TargetsSummary}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DgCellTextEllipsis}">
                                        <Setter Property="ToolTip" Value="{Binding TargetsSummary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Libéré"
                                                Binding="{Binding BytesDisplay}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Durée"
                                                Binding="{Binding DurationDisplay}"
                                                Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Journal">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <TextBox x:Name="txtScanJournal"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="11"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextDark}"/>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Border>

    </Grid>
</UserControl>
