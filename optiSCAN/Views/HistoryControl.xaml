<UserControl x:Class="optiSCAN.Views.HistoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:optiSCAN.Localization">

    <DockPanel Background="{DynamicResource ContentBg}">

        <!-- ══ HERO BAND ═══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Margin="24,16,24,0"
                CornerRadius="12"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                Background="{DynamicResource PageHeaderMica}"
                Effect="{DynamicResource CardShadow}"
                Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Key=Hist_Title}"
                               FontSize="{DynamicResource FontSize.Hero}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDark}"/>
                    <TextBlock Text="{loc:Loc Key=Hist_Sub}"
                               FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource TextMuted}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Boutons d'export — style ExportButton défini dans Controls.xaml -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="{loc:Loc Key=Hist_ExportHtml}"
                            Click="BtnExportHtml_Click"
                            Style="{StaticResource ExportButton}"
                            Margin="0,0,8,0"
                            ToolTip="Rapport HTML (historique, quarantaine, menaces actives)"/>

                    <Button Content="{loc:Loc Key=Hist_ExportPdf}"
                            Click="BtnExportSelectedPdf_Click"
                            Style="{StaticResource ExportButton}"
                            Margin="0,0,8,0"
                            ToolTip="PDF de la ligne sélectionnée dans Scans antivirus"/>

                    <Button Click="BtnOpenAntivirus_Click"
                            Style="{StaticResource ExportButton}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <md:PackIcon Kind="ShieldCheck" Width="15" Height="15"
                                             Foreground="{DynamicResource TextAccent}"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Key=Hist_OpenAv}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDark}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>

                <!-- Cercle décoratif -->
                <Border Grid.Column="1" Width="0" Height="0" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ══ CORPS : onglets + grille ══════════════════════════════════== -->
        <Border Background="{DynamicResource CardBg}"
                CornerRadius="12" Margin="24,16,24,24"
                Effect="{DynamicResource CardShadow}">
            <TabControl Background="Transparent" BorderThickness="0"
                        Padding="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource DonabyTabItemUnderline}"/>
                </TabControl.ItemContainerStyle>

                <!-- Scans antivirus -->
                <TabItem Header="{loc:Loc Key=Hist_TabScans}">
                    <DataGrid x:Name="dgScanHistory"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderSubtle}"
                              Background="Transparent"
                              BorderThickness="0"
                              ColumnHeaderStyle="{DynamicResource DgHeader}"
                              RowStyle="{DynamicResource DgRow}"
                              AlternationCount="2"
                              VirtualizingPanel.IsVirtualizing="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Key=Hist_ColDate}"
                                                Binding="{Binding StartedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                Width="155"/>
                            <DataGridTextColumn Header="{loc:Loc Key=Hist_ColType}"
                                                Binding="{Binding TypeDisplay}"
                                                Width="130"/>
                            <DataGridTextColumn Header="{loc:Loc Key=Hist_ColTarget}"
                                                Binding="{Binding TargetPath}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DgCellTextEllipsis}">
                                        <Setter Property="ToolTip" Value="{Binding TargetPath}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc Key=Hist_ColFiles}"
                                                Binding="{Binding FilesScanned, StringFormat={}{0:N0}}"
                                                Width="90"/>
                            <DataGridTextColumn Header="{loc:Loc Key=Hist_ColDuration}"
                                                Binding="{Binding DurationDisplay}"
                                                Width="100"/>
                            <DataGridTextColumn Header="{loc:Loc Key=Hist_ColResult}"
                                                Binding="{Binding ThreatsBadge}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DgCellTextEllipsis}">
                                        <Setter Property="ToolTip" Value="{Binding ThreatsBadge}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Nettoyages système -->
                <TabItem Header="{loc:Loc Key=Hist_TabCleans}">
                    <DataGrid x:Name="dgCleanHistory"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderSubtle}"
                              Background="Transparent"
                              BorderThickness="0"
                              ColumnHeaderStyle="{DynamicResource DgHeader}"
                              RowStyle="{DynamicResource DgRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Key=Hist_ColDate}"
                                                Binding="{Binding DateDisplay}"
                                                Width="155"/>
                            <DataGridTextColumn Header="{loc:Loc Key=Hist_ColTargets}"
                                                Binding="{Binding TargetsSummary}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DgCellTextEllipsis}">
                                        <Setter Property="ToolTip" Value="{Binding TargetsSummary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc Key=Hist_ColFreed}"
                                                Binding="{Binding BytesDisplay}"
                                                Width="100"/>
                            <DataGridTextColumn Header="{loc:Loc Key=Hist_ColDuration}"
                                                Binding="{Binding DurationDisplay}"
                                                Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Journal -->
                <TabItem Header="{loc:Loc Key=Hist_TabLog}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <TextBox x:Name="txtScanJournal"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontSize.Small}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextDark}"/>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Border>

    </DockPanel>
</UserControl>
