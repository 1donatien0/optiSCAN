<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- ╔══════════════════════════════════════════════════════════════════╗
         ║  NOTE : CardShadow est défini dans chaque thème (Donaby.*.xaml) ║
         ║  pour s'adapter au mode clair/sombre. Ne pas le redéfinir ici.  ║
         ╚══════════════════════════════════════════════════════════════════╝ -->

    <!-- Style DataGridHeader -->
    <Style x:Key="DgHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background"       Value="{DynamicResource SurfaceBg}"/>
        <Setter Property="Foreground"       Value="{DynamicResource TextMedium}"/>
        <Setter Property="FontFamily"       Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontWeight"       Value="SemiBold"/>
        <Setter Property="FontSize"         Value="{DynamicResource FontSize.Small}"/>
        <Setter Property="Padding"          Value="10,8"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness"  Value="0,0,0,1"/>
    </Style>

    <!-- Style DataGridRow -->
    <Style x:Key="DgRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDark}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"   Value="{DynamicResource FontSize.Body}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            </Trigger>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource HeaderBg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Cellule DataGrid : texte sur une ligne + infobulle (chemin long, etc.) -->
    <Style x:Key="DgCellTextEllipsis" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Style PrimaryButton -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background"      Value="{DynamicResource PrimaryBlue}"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextOnPrimary}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSize.Title}"/>
        <Setter Property="Padding"         Value="14,9"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style DangerButton -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource DangerRed}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnPrimary}"/>
    </Style>

    <!-- Style WarningButton -->
    <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource WarningOrange}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnPrimary}"/>
    </Style>

    <!-- Style SuccessButton -->
    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource SuccessGreen}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnPrimary}"/>
    </Style>

    <!-- Style SecondaryButton -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent"
                            BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style ExportButton — bouton outlined thématisé (CardBg + BorderColor)
         Utilisé dans HistoryControl pour les boutons d'export HTML/PDF/nav. -->
    <Style x:Key="ExportButton" TargetType="Button">
        <Setter Property="Height"          Value="34"/>
        <Setter Property="Padding"         Value="14,0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BorderColor}"/>
        <Setter Property="Background"      Value="{DynamicResource CardBg}"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextDark}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Carte hub Antivirus (bouton avec contenu via ContentPresenter) -->
    <Style x:Key="HubCardButtonStyle" TargetType="Button">
        <Setter Property="OverridesDefaultStyle"  Value="True"/>
        <Setter Property="Cursor"                 Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment"   Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="card"
                            Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,8"
                            MinHeight="88">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="card" Property="Background" Value="{DynamicResource CardBgHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="card" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Texte affiché dans ComboBox (ComboBoxItem.Content ou chaîne / heure) -->
    <DataTemplate x:Key="DonabyComboBoxTextTemplate">
        <TextBlock VerticalAlignment="Center"
                   FontFamily="{DynamicResource AppFontFamily}"
                   FontSize="{DynamicResource FontSize.Body}"
                   Foreground="{DynamicResource TextDark}">
            <TextBlock.Text>
                <PriorityBinding FallbackValue="">
                    <Binding Path="Content"/>
                    <Binding/>
                </PriorityBinding>
            </TextBlock.Text>
        </TextBlock>
    </DataTemplate>

    <Style x:Key="DonabyComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextDark}"/>
        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="itemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource AccentBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextDark}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource AccentBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextDark}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox thématisé (évite le fond blanc système en mode sombre) -->
    <Style x:Key="DonabyComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextDark}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="Padding" Value="10,6,28,6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ItemTemplate" Value="{StaticResource DonabyComboBoxTextTemplate}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource DonabyComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="comboBorder"
                                Grid.ColumnSpan="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"/>
                        <!-- SelectionBoxItemTemplate est en lecture seule : pas de Setter de style (MC3080). -->
                        <ContentPresenter x:Name="selectionPresenter"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{StaticResource DonabyComboBoxTextTemplate}"
                                          TextElement.Foreground="{DynamicResource TextDark}"
                                          IsHitTestVisible="False"/>
                        <ToggleButton x:Name="dropDownToggle"
                                      Grid.ColumnSpan="2"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Cursor="Hand"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Release">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"
                                            MinHeight="{TemplateBinding MinHeight}"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Path Grid.Column="1"
                              Data="M0,0 L4,4 L8,0 Z"
                              Fill="{DynamicResource TextMuted}"
                              Width="8" Height="5"
                              Margin="0,0,10,0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=comboBorder}"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="2"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="comboBorder" Property="Opacity" Value="0.55"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="comboBorder" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="comboBorder" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Boutons compacts hub Antivirus (dossier / fichier) -->
    <Style x:Key="AntivirusHubActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Padding"                    Value="8,5"/>
        <Setter Property="FontSize"                   Value="{DynamicResource FontSize.Small}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- Onglets principaux (Antivirus, etc.) — contraste sélectionné / non sélectionné -->
    <Style x:Key="DonabyTabItem" TargetType="TabItem">
        <Setter Property="Background" Value="{DynamicResource HeaderBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1,1,1,0"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="tabBg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8,8,0,0">
                        <ContentPresenter x:Name="headerPresenter"
                                          ContentSource="Header"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="tabBg" Property="Background" Value="{DynamicResource PrimaryBlue}"/>
                            <Setter TargetName="tabBg" Property="BorderBrush" Value="{DynamicResource PrimaryBlue}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimary}"/>
                            <Setter TargetName="headerPresenter" Property="TextElement.Foreground"
                                    Value="{DynamicResource TextOnPrimary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tabBg" Property="BorderBrush" Value="{DynamicResource PrimaryBlue}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource TextDark}"/>
                            <Setter TargetName="headerPresenter" Property="TextElement.Foreground"
                                    Value="{DynamicResource TextDark}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Onglets soulignés (Historique) -->
    <Style x:Key="DonabyTabItemUnderline" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="bg" Background="Transparent"
                            BorderBrush="{DynamicResource PrimaryBlue}"
                            BorderThickness="0,0,0,2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="headerPresenter"
                                          ContentSource="Header"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextDark}"/>
                            <Setter TargetName="headerPresenter" Property="TextElement.Foreground"
                                    Value="{DynamicResource TextDark}"/>
                            <Setter TargetName="bg" Property="BorderThickness" Value="0,0,0,2"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter TargetName="bg" Property="BorderThickness" Value="0"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource TextMedium}"/>
                            <Setter TargetName="headerPresenter" Property="TextElement.Foreground"
                                    Value="{DynamicResource TextMedium}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icônes dans en-têtes d'onglets (héritent Foreground du TabItem) -->
    <Style x:Key="TabHeaderPackIcon" TargetType="md:PackIcon">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
    </Style>

    <!-- Style NavItem — icône + label centrés, sidebar slim 90px -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="GroupName"          Value="Navigation"/>
        <Setter Property="Background"         Value="Transparent"/>
        <Setter Property="Foreground"         Value="{DynamicResource SidebarText}"/>
        <Setter Property="Height"             Value="70"/>
        <Setter Property="Cursor"             Value="Hand"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bg" Background="Transparent">
                        <Grid>
                            <!-- Indicateur gauche actif -->
                            <Rectangle x:Name="bar" Width="3" HorizontalAlignment="Left"
                                       Fill="Transparent" RadiusX="2" RadiusY="2"/>
                            <!-- Overlay hover -->
                            <Rectangle x:Name="hoverOverlay"
                                       Fill="{DynamicResource AccentBlue}" Opacity="0"/>
                            <!-- Contenu : icône + label empilés au centre -->
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SidebarActiveItem}"/>
                            <Setter TargetName="bar" Property="Fill"       Value="{DynamicResource SidebarIndicator}"/>
                            <Setter Property="Foreground"                  Value="{DynamicResource SidebarTextActive}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hoverOverlay" Property="Opacity" Value="0.07"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
