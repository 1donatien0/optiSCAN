<?xml version="1.0" encoding="utf-8"?>
<!-- Configuration d'artefact SignPath « installer » : l'archive contient l'installeur Inno Setup
     compilé à partir des binaires déjà signés par la configuration « binaries ». -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="optiSCAN_Setup_v*.exe" max-matches="1" product-name="optiSCAN">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
