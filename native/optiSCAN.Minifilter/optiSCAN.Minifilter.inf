; optiSCAN Minifilter INF stub (v1)
; Compilation complète requiert WDK + certificat EV

[Version]
Signature="$Windows NT$"
Class=ActivityMonitor
ClassGuid={b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider=%Manufacturer%
DriverVer=06/15/2026,1.0.0.0
CatalogFile=optiSCAN.Minifilter.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%Manufacturer%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName%=optiSCAN_Minifilter, optiSCANMinifilter

[optiSCAN_Minifilter.NT]
CopyFiles = optiSCAN_Minifilter_Copy

[optiSCAN_Minifilter_Copy]
optiSCAN.Minifilter.sys

[Strings]
Manufacturer="optiSCAN"
DeviceName="optiSCAN File System Minifilter v1"
